    "responses": {
      "400": {
        "description": "Bad Request",
        "content": {
          "application/vnd.api+json": {
            "schema": {
              "$ref": "#/components/schemas/Errors-detailed"
            },
            "example": {
              "errors": [
                {
                  "id": "{datasetId}",
                  "source": {
                    "pointer": "path/to/invalid/field",
                    "parameter": "parameterName",
                    "header": "headerName"
                  },
                  "title": "Invalid request",
                  "detail": "{description of the issue}",
                  "status": 400,
                  "links": [],
                  "meta": {}
                }
              ]
            }
          }
        }
      },
