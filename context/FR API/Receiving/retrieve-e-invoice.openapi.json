{
  "openapi": "3.1.0",
  "info": {
    "title": "Retrieve e-invoice.",
    "version": "1.0.0",
    "description": "Retrieve an e-invoice by ID. When `format=facturx` is specified, the endpoint generates a Factur-X/ZUGFeRD 2.3 hybrid PDF on the fly from the invoice's UBL XML and PDF attachments and includes it in the response attachments list. If the invoice already has a FacturX attachment, it is returned directly without regeneration. Set `includeAttachments=false` to omit the attachments field and skip download URL generation. This also skips FacturX generation when `format=facturx` is supplied.\n",
    "contact": {
      "name": "Sage Network Accounts Team",
      "email": "email.protected@sage.com"
    },
    "license": {
      "name": "Sage Terms and Conditions",
      "url": "https://www.sage.com/en-us/legal/terms/"
    }
  },
  "externalDocs": {
    "url": "https://developer.sage.com/network/",
    "description": "Sage Network e-Invoicing Service Documentation"
  },
  "servers": [
    {
      "url": "https://api.e-invoicing.sage.com",
      "description": "Production"
    },
    {
      "url": "https://api-sbx.e-invoicing.sage.com",
      "description": "Sandbox-Production"
    },
    {
      "url": "https://api-int.e-invoicing-eng.sage.com",
      "description": "Internal Sandbox"
    }
  ],
  "security": [
    {
      "m2m": []
    }
  ],
