nresolved" style="rhombus;fillColor=#d7d7d7;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1670" y="380" width="240" height="110" as="geometry" /></mxCell><mxCell id="d6" value="OFF-04&lt;br&gt;&lt;b&gt;Resume or restore&lt;/b&gt;&lt;br&gt;New evidenced transition" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2010" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="d4" value="OFF-08&lt;br&gt;&lt;b&gt;Observe original&lt;/b&gt;&lt;br&gt;Query provider operation ID" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1330" y="568" width="230" height="100" as="geometry" /></mxCell><mxCell id="d7" value="OFF-05&lt;br&gt;&lt;b&gt;Protect history&lt;/b&gt;&lt;br&gt;Original actor and channel" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2350" y="568" width="230" height="100" as="geometry" /></mxCell><mxCell id="d1" value="OFF-08&lt;br&gt;&lt;b&gt;Detect incident&lt;/b&gt;&lt;br&gt;Timeout, outage or reversal" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="310" y="746" width="230" height="100" as="geometry" /></mxCell><mxCell id="d9" value="HOLD&lt;br&gt;&lt;b&gt;Escalate unresolved&lt;/b&gt;&lt;br&gt;Manual owner and deadline" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1670" y="746" width="240" height="100" as="geometry" /></mxCell><mxCell id="footer" value="An uncertain mutation or provider outage stays visible until the original state and obligations are owned. A reversal is a new transition. No blind retry; every invoice keeps its actual origin and unfinished obligations retain a permitted path." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="921" width="2750" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>