        <mxCell id="v36" value="The selected private platform sends the copy. Its capability is expected but unconfirmed. When Sage operates&#10;as the private platform, Sage performs that role. Qualify coordination with ERP issuance under OUT-Q03." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=16;fontColor=#B42318;">
          <mxGeometry as="geometry" x="52" y="930" width="1100.64" height="49" />
