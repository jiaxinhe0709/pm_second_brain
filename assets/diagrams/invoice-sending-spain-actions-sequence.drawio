        </mxCell>
        <mxCell id="v42" value="Use the six-case OUT-09 rule. A no-match alone does not authorise public delivery. Product and Spain&#10;Compliance must resolve the communicated-address source conflict; hold dispatch when the rule or evidence is&#10;unresolved." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=16;fontColor=#B42318;">
