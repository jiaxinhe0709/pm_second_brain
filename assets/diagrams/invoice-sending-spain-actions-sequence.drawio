        </mxCell>
        <mxCell id="v39" value="Qualify how the private platform reports copy results and errors to Sage, and who retries a failed copy. A&#10;missing report leaves that action unresolved; it must not repeat completed recipient delivery." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=16;fontColor=#B42318;">
          <mxGeometry as="geometry" x="52" y="1444" width="1080.48" height="49" />
