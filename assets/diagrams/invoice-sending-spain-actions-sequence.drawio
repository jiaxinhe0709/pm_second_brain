        <mxCell id="v33" value="Qualify authority, recipient eligibility, final files and trust. Freeze one recipient route and separate&#10;action identities. Per-invoice choice does not change the active route; onboarding confirmation remains open." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=16;fontColor=#B42318;">
