                <mxCell id="delivery-uncertain" edge="1" parent="1" source="e6" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2;exitX=0.2692307692307692;exitY=1.0;entryX=0.2692307692307692;entryY=0.0;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=6 4;" target="delivery-recovery">
