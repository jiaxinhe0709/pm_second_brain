                <mxCell id="footer" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontSize=13;" value="&lt;b&gt;Solid:&lt;/b&gt; usual receiving steps. &lt;b&gt;Dashed:&lt;/b&gt; conditional work, holds or recovery.&lt;br&gt;&lt;b&gt;R marker:&lt;/b&gt; when the original arrives, return to receiving step 1. Keep one invoice and the same delivery ID.&lt;br&gt;DTS converts to UBL 2.5 only in Phase 3 when the received format is different. Keep the original and check the converted result.&lt;br&gt;Safe authorised consultation and file access can continue while ERP delivery waits. Source confirmation follows its own contract milestone.&lt;br&gt;ERP receipt is separate from accounting/import choices and buyer acceptance. Logical responsibilities; actual service coverage remains to be confirmed." vertex="1">
                    <mxGeometry height="100" width="2730" x="25" y="1150" as="geometry"/>
                </mxCell>
                <mxCell id="resume-start" parent="1" style="rounded=1;arcSize=100;html=1;fillColor=#ffffff;strokeColor=#555555;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" value="R" vertex="1">
                    <mxGeometry height="28" width="32" x="300" y="615" as="geometry"/>
                </mxCell>
                <mxCell id="resume-original" parent="1" style="rounded=1;arcSize=100;html=1;fillColor=#ffffff;strokeColor=#555555;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" value="R" vertex="1">
                    <mxGeometry height="28" width="32" x="1230" y="701" as="geometry"/>
                </mxCell>
                <mxCell id="label-source-acknowledgement" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=12;fillColor=#fafafa;" value="When source requires it" vertex="1">
