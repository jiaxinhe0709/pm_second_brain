ounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="650" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="e4" value="RCV-04&lt;br&gt;&lt;b&gt;Resolve duplicate&lt;/b&gt;&lt;br&gt;Business and network identity" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1330" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="e6" value="RCV-07&lt;br&gt;&lt;b&gt;Publish once&lt;/b&gt;&lt;br&gt;Durable record and product event" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2010" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="e9" value="RCV-09&lt;br&gt;&lt;b&gt;Quarantine / link&lt;/b&gt;&lt;br&gt;Wrong, unsafe or conflicting" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1330" y="510" width="230" height="100" as="geometry" /></mxCell><mxCell id="e3" value="RCV-03&lt;br&gt;&lt;b&gt;Assess trust&lt;/b&gt;&lt;br&gt;Safety, integrity and replay" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="990" y="688" width="230" height="100" as="geometry" /></mxCell><mxCell id="e5" value="RCV-05 / 06&lt;br&gt;&lt;b&gt;Validate and map&lt;/b&gt;&lt;br&gt;Original kept; canonical distinct" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1670" y="688" width="230" height="100" as="geometry" /></mxCell><mxCell id="e7" value="RCV-08&lt;br&gt;&lt;b&gt;Acknowledge source&lt;/b&gt;&lt;br&gt;Separate technical outcome" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2350" y="688" width="230" height="100" as="geometry" /></mxCell><mxCell id="footer" value="Public retrieval and private arrival converge on recipient, trust, duplicate and original-file controls. A duplicate links source evidence to one business invoice. Quarantine is owned and cannot be called trusted delivery." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="863" width="2750" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>