                <mxCell id="phase0" parent="1" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;" value="1  RECORD FILE" vertex="1">
