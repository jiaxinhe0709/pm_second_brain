<mxfile host="65bd71144e">
    <diagram id="receiving-intake-and-delivery-process" name="Receiving: trusted intake to one product invoice">
        <mxGraphModel dx="1302" dy="887" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2790" pageHeight="1270" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontSize=26;fontStyle=1;" value="Receive invoice — detailed background checks and ERP delivery" vertex="1">
                    <mxGeometry height="42" width="2730" x="25" y="15" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" value="Inbound processing only. The phase band applies to this receiving flow; Customer list, open, download and review actions are separate in the overview." vertex="1">
                    <mxGeometry height="30" width="2730" x="25" y="65" as="geometry"/>
                </mxCell>
                <mxCell id="lane-1" parent="1" style="shape=swimlane;horizontal=0;startSize=250;noLabel=1;fillColor=#e5e5e5;swimlaneFillColor=#fafafa;strokeColor=#aaaaaa;" value="ERP / product" vertex="1">
                    <mxGeometry height="150" width="2730" x="25" y="280" as="geometry"/>
                </mxCell>
                <mxCell id="e8" parent="lane-1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;fillColor=#e8e8e8;" value="&lt;b&gt;7. Save invoice and confirm receipt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Do not save another invoice for a repeat delivery&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RCV-07; RCV-A14&lt;/span&gt;" vertex="1">
                    <mxGeometry height="110" width="260" x="2135" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="lane-1-label" parent="1" style="text;html=1;fontSize=15;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=16;strokeColor=none;fillColor=none;" value="&lt;b&gt;ERP / product&lt;/b&gt;" vertex="1">
                    <mxGeometry height="150" width="250" x="25" y="280" as="geometry"/>
                </mxCell>
                <mxCell id="lane-2" parent="1" style="shape=swimlane;horizontal=0;startSize=250;noLabel=1;fillColor=#e5e5e5;swimlaneFillColor=#fafafa;strokeColor=#aaaaaa;" value="Domain Service - E-Invoice Service" vertex="1">
                    <mxGeometry height="360" width="2730" x="25" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="e1" parent="lane-2" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;fillColor=#e8e8e8;" value="&lt;b&gt;1. Record the received file&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep the saved file reference and its source&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RCV-01; RSD-04&lt;/span&gt;" vertex="1">
                    <mxGeometry height="110" width="250" x="275" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="e4" parent="lane-2" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;fillColor=#e8e8e8;" value="&lt;b&gt;2. Identify the invoice and label the file&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Read the invoice reference and original/copy indicator&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RCV-04; RCV-SPFE-R02&lt;/span&gt;" vertex="1">
                    <mxGeometry height="110" width="260" x="585" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="e9" parent="lane-2" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;fillColor=#d7d7d7;" value="&lt;b&gt;Hold the invoice for review&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Show what failed and who must resolve it&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RCV-09; section 3.3&lt;/span&gt;" vertex="1">
                    <mxGeometry height="110" width="260" x="585" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="original-gate" parent="lane-2" style="shape=rhombus;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;fillColor=#e8e8e8;" value="&lt;b&gt;3. Is the original available?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;REF-COPY-POLICY&lt;/span&gt;" vertex="1">
                    <mxGeometry height="130" width="280" x="895" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="copy-pending" parent="lane-2" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;fillColor=#d7d7d7;dashed=1;dashPattern=8 8;" value="&lt;b&gt;Wait for the original before ERP delivery&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Users can still view or download a safe, authorised copy&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;REF-COPY-POLICY&lt;/span&gt;" vertex="1">
                    <mxGeometry height="110" width="280" x="895" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="e6" parent="lane-2" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;fillColor=#e8e8e8;" value="&lt;b&gt;6. Send the invoice to the ERP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep the same delivery ID for retries&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RCV-07&lt;/span&gt;" vertex="1">
                    <mxGeometry height="110" width="260" x="1825" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="receipt" parent="lane-2" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;fillColor=#ffffff;" value="&lt;b&gt;8. Record the ERP confirmation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;ERP receipt is separate from buyer acceptance&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RCV-07&lt;/span&gt;" vertex="1">
                    <mxGeometry height="110" width="260" x="2445" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="delivery-recovery" parent="lane-2" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;fillColor=#d7d7d7;" value="&lt;b&gt;Check whether the ERP received it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Check before sending again; use the same delivery ID&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RCV-07/09&lt;/span&gt;" vertex="1">
                    <mxGeometry height="110" width="260" x="1825" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="lane-2-label" parent="1" style="text;html=1;fontSize=15;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=16;strokeColor=none;fillColor=none;" value="&lt;b&gt;Domain Service -&lt;br&gt;E-Invoice Service&lt;/b&gt;" vertex="1">
                    <mxGeometry height="360" width="250" x="25" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="lane-3" parent="1" style="shape=swimlane;horizontal=0;startSize=250;noLabel=1;fillColor=#e5e5e5;swimlaneFillColor=#fafafa;strokeColor=#aaaaaa;" value="Domain Service - Other Services" vertex="1">
                    <mxGeometry height="320" width="2730" x="25" y="810" as="geometry"/>
                </mxCell>
                <mxCell id="e5" parent="lane-3" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;fillColor=#e8e8e8;" value="&lt;b&gt;4. Check invoice format and rules&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Check the received format; keep the original file&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RCV-05&lt;/span&gt;" vertex="1">
                    <mxGeometry height="110" width="260" x="1205" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="map" parent="lane-3" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;fillColor=#e8e8e8;dashed=1;dashPattern=6 4;" value="&lt;b&gt;5. Convert to UBL 2.5 if needed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;DTS: Phase 3, other input formats&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RCV-06; REF-DTS-SCOPE&lt;/span&gt;" vertex="1">
                    <mxGeometry height="110" width="260" x="1515" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="processing-hold" parent="lane-3" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;fillColor=#d7d7d7;" value="&lt;b&gt;Review the failed check or conversion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep the original; retry only the failed step&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RCV-09; section 3.3&lt;/span&gt;" vertex="1">
                    <mxGeometry height="110" width="260" x="1515" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="e7" parent="lane-3" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;fillColor=#e8e8e8;dashed=1;" value="&lt;b&gt;Confirm receipt to source, if required&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Follow source rules; check before sending again&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RCV-08&lt;/span&gt;" vertex="1">
                    <mxGeometry height="110" width="250" x="275" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="lane-3-label" parent="1" style="text;html=1;fontSize=15;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=16;strokeColor=none;fillColor=none;" value="&lt;b&gt;Domain Service -&lt;br&gt;Other Services&lt;/b&gt;" vertex="1">
                    <mxGeometry height="320" width="250" x="25" y="810" as="geometry"/>
                </mxCell>
                <mxCell id="lane-4" parent="1" style="shape=swimlane;horizontal=0;startSize=250;noLabel=1;fillColor=#e5e5e5;swimlaneFillColor=#fafafa;strokeColor=#aaaaaa;" value="Customer / accountant" vertex="1">
                    <mxGeometry height="100" width="2730" x="25" y="170" as="geometry"/>
                </mxCell>
                <mxCell id="automatic-trigger-note" parent="lane-4" style="text;html=0;whiteSpace=wrap;align=left;fontSize=16;spacing=8;" value="No customer action is needed. File-read checks happen while getting and saving the file, before this receiving flow starts." vertex="1">
                    <mxGeometry height="60" width="1080" x="285" y="20" as="geometry"/>
