eometry" /></mxCell><mxCell id="c2" value="OFF-02 / G2&lt;br&gt;&lt;b&gt;Inventory work&lt;/b&gt;&lt;br&gt;Invoices, obligations, access" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="650" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="c4" value="OFF-04 / G4&lt;br&gt;&lt;b&gt;Cut over traffic&lt;/b&gt;&lt;br&gt;Observed effective boundary" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1330" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="c5" value="OFF-05 / G5&lt;br&gt;&lt;b&gt;Assign history&lt;/b&gt;&lt;br&gt;Actor, channel and due date" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1670" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="c9" value="OFF-08&lt;br&gt;&lt;b&gt;Hold and reconcile&lt;/b&gt;&lt;br&gt;Unknown / failed gate" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1330" y="688" width="230" height="100" as="geometry" /></mxCell><mxCell id="c6" value="OFF-06 / G6&lt;br&gt;&lt;b&gt;Release old route&lt;/b&gt;&lt;br&gt;Withdraw / revoke separately" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2010" y="866" width="230" height="100" as="geometry" /></mxCell><mxCell id="c7" value="OFF-07 / G7&lt;br&gt;&lt;b&gt;Export / dispose&lt;/b&gt;&lt;br&gt;Manifest, hold and schedule" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2350" y="866" width="230" height="100" as="geometry" /></mxCell><mxCell id="c3" value="OFF-03 / G3&lt;br&gt;&lt;b&gt;Prove destination&lt;/b&gt;&lt;br&gt;Inbound reachability if needed" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="990" y="1044" width="230" height="100" as="geometry" /></mxCell><mxCell id="footer" value="Seven independent gates protect receipt, in-flight work, historical obligations and data disposition. Cutover, historical continuity, provider release, subscription end and data disposition are separate results." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1219" width="2750" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>