<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device"><diagram id="lifecycle-reporting-reconciliation-process" name="Lifecycle reporting: independent obligations"><mxGraphModel dx="3140" dy="1126" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3140" pageHeight="1126" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Send required reports and check uncertain results" style="text;html=1;align=left;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="15" width="3090" height="42" /></mxCell><mxCell id="subtitle" value="Logical responsibility groups; exact service owners and implementation remain open in the owning spec." style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="58" width="3090" height="30" /></mxCell><mxCell id="phase0" value="RECEIVE &amp; CHECK INFORMATION" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="285" y="98" width="925.0" height="28" as="geometry" /></mxCell><mxCell id="phase1" value="SAVE &amp; INTERPRET INFORMATION" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="1220.0" y="98" width="585" height="28" as="geometry" /></mxCell><mxCell id="phase2" value="SEND REQUIRED REPORTS" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="1815.0" y="98" width="605" height="28" as="geometry" /></mxCell><mxCell id="phase3" value="SHOW RESULTS &amp; RECOVER" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middl