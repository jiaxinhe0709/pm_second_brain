t / no result" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1790.5" y="648" width="112.5" height="22" /></mxCell><mxCell id="business-input" value="SOURCE&lt;br&gt;&lt;b&gt;Record business event&lt;/b&gt;&lt;br&gt;Authorised rejection or payment" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;"><mxGeometry as="geometry" x="310" y="202" width="230" height="100" /></mxCell><mxCell id="b7" value="END&lt;br&gt;&lt;b&gt;Show next action&lt;/b&gt;&lt;br&gt;Deadline and evidence source" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2780" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="b1" value="LCS-02 / 04&lt;br&gt;&lt;b&gt;Authorise event&lt;/b&gt;&lt;br&gt;Invoice, actor and country rule" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="650" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b2" value="LCS-07&lt;br&gt;&lt;b&gt;Plan destinations&lt;/b&gt;&lt;br&gt;Historic route and deadline" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="990" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b3" value="LCS-08&lt;br&gt;&lt;b&gt;Create obligations&lt;/b&gt;&lt;br&gt;One event, one per destination" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1330" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b5" value="DECISION&lt;br&gt;&lt;b&gt;Outcome known?&lt;/b&gt;&lt;br&gt;Per destination result" style="rhombus;fillColor=#d7d7d7;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2010" y="380" width="240" height="110" as="geometry" /></mxCell><mxCell id="b6" value="LCS-05 / 06&lt;br&gt;&lt;b&gt;Update view&lt;/b&gt;&lt;br&gt;Known and pending separately" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2350" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b8" value="LCS-10&lt;br&gt;&lt;b&gt;Reconcile original&lt;/b&gt;&lt;br&gt;Query before unsafe repeat" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2010" y="520" width="230" height="100" as="geometry" /></mxCell><mxCell id="b4" value="LCS-09&lt;br&gt;&lt;b&gt;Deliver each action&lt;/b&gt;&lt;br&gt;Stable identity and payload" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1670" y="698" width="230" height="100" as="geometry" /></mxCell><mxCell id="platform-result" value="RESULT&lt;br&gt;&lt;b&gt;Return reporting result&lt;/b&gt;&lt;br&gt;Public / private destination" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;"><mxGeometry as="geometry" x="1670" y="876" width="230" height="100" /></mxCell><mxCell id="footer" value="Report an authorised business event only to its required destinations. Each public/private destination returns its own reporting result. Report acceptance does not fabricate buyer acceptance or payment. Receiving a platform status update must not automatically report it again." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1051" width="3090" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>