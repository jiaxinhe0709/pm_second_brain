ent="1" source="b5" target="b8" workflowLabel="unknown"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2130" y="510" /><mxPoint x="2125" y="510" /></Array></mxGeometry></mxCell><mxCell id="label-e7" value="unknown" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2137" y="494" width="46.5" height="22" /></mxCell><mxCell id="input-business" source="business-input" target="b1" edge="1" parent="1" value="" workflowLabel="" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#444444;strokeWidth=2;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="252" /><mxPoint x="550" y="430" /></Array></mxGeometry></mxCell><mxCell id="report-response" source="platform-result" target="b5" edge="1" parent="1" value="" workflowLabel="response" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#444444;strokeWidth=2;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1910" y="926" /><mxPoint x="1910" y="435" /></Array></mxGeometry></mxCell><mxCell id="label-report-response" value="response" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1917" y="669.5" width="52" height="22" /></mxCell><mxCell id="report-no-result" source="b4" target="b8" edge="1" parent="1" value="" workflowLabel="timeout / no result" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#444444;strokeWidth=2;dashed=1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1910" y="748" /><mxPoint x="1910" y="570" /></Array></mxGeometry></mxCell><mxCell id="label-report-no-result" value="timeout / no result" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1790.5" y="648" width="112.5" height="22" /></mxCell><mxCell id="business-input" value="&lt;b&gt;Record a business event&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Authorised rejection or payment&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;"><mxGeometry as="geometry" x="310" y="202" width="230" height="100" /></mxCell><mxCell id="b7" value="&lt;b&gt;Show the next required action&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Deadline and evidence source&lt;/span&gt;" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2780" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="b1" value="&lt;b&gt;Check permission for the event&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Invoice, actor and country rule&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LCS-02 / 04&lt;/span&gt;" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="650" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b&gt;Identify required report destinations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Earlier invoice route and reporting deadline&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LCS-07&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="990" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b3" value="&lt;b&gt;Create each required report&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;One event; separate work per destination&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LCS-08&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1330" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b5" value="&lt;b&gt;Is the reporting result known?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Check each destination separately&lt;/span&gt;" style="rhombus;fillColor=#d7d7d7;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2010" y="380" width="240" height="110" as="geometry" /></mxCell><mxCell id="b6" value="&lt;b&gt;Update status and reporting progress&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep known and pending results separate&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LCS-05 / 06&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2350" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b8" value="&lt;b&gt;Check the original report&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Establish the outcome before an unsafe retry&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LCS-10&lt;/span&gt;" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2010" y="520" width="230" height="100" as="geometry" /></mxCell><mxCell id="b4" value="&lt;b&gt;Send each required report&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep its request identity and exact content&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LCS-09&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1670" y="698" width="230" height="100" as="geometry" /></mxCell><mxCell id="platform-result" value="&lt;b&gt;Return the reporting result&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Public or private destination&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;"><mxGeometry as="geometry" x="1670" y="876" width="230" height="100" /></mxCell><mxCell id="footer" value="Report an authorised business event only to its required destinations. Each public/private destination returns its own reporting result. Report acceptance does not fabricate buyer acceptance or payment. Receiving a platform status update must not automatically report it again." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1051" width="3090" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>