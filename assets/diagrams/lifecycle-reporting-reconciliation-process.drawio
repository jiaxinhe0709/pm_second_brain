xCell id="b1" value="LCS-02 / 04&lt;br&gt;&lt;b&gt;Authorise event&lt;/b&gt;&lt;br&gt;Invoice, actor and country rule" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="310" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b2" value="LCS-07&lt;br&gt;&lt;b&gt;Plan destinations&lt;/b&gt;&lt;br&gt;Historic route and deadline" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="650" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b3" value="LCS-08&lt;br&gt;&lt;b&gt;Create obligations&lt;/b&gt;&lt;br&gt;One event, one per destination" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="990" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b5" value="DECISION&lt;br&gt;&lt;b&gt;Outcome known?&lt;/b&gt;&lt;br&gt;Per destination result" style="rhombus;fillColor=#d7d7d7;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1670" y="380" width="240" height="110" as="geometry" /></mxCell><mxCell id="b6" value="LCS-05 / 06&lt;br&gt;&lt;b&gt;Update view&lt;/b&gt;&lt;br&gt;Known and pending separately" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2010" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b8" value="LCS-10&lt;br&gt;&lt;b&gt;Reconcile original&lt;/b&gt;&lt;br&gt;Query before unsafe repeat" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1670" y="520" width="230" height="100" as="geometry" /></mxCell><mxCell id="b4" value="LCS-09&lt;br&gt;&lt;b&gt;Deliver each action&lt;/b&gt;&lt;br&gt;Stable identity and payload" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1330" y="698" width="230" height="100" as="geometry" /></mxCell><mxCell id="footer" value="One authorised business event can require separate issuer and public reports with distinct outcomes. Issuer and public-platform actions remain independent. A known success is not replayed because another destination is uncertain." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="873" width="2750" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>