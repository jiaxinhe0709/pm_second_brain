        <object id="private-condition" label="The public platform has only a copy.&#10;The company can access the private original." link="../../specs/invoice-receiving/SPEC-SEI-026-invoice-retrieval-logical-feature-specification.md#34-process-review-proposal">
          <mxCell parent="1" vertex="1" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Arial;fontSize=18;strokeColor=#666666;strokeWidth=1.5;fillColor=#fafafa;">
