          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <object id="copy-condition" label="The public platform has only a copy.&#10;No private platform is set up, or the private original cannot be accessed." link="../../specs/invoice-receiving/SPEC-SEI-026-invoice-retrieval-logical-feature-specification.md#34-process-review-proposal">
