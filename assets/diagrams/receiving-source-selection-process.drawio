          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <object id="no-file" label="No permitted file is available? Keep the invoice pending and show what is missing. A failed request does not mean there are no invoices." link="../../specs/invoice-receiving/SPEC-SEI-026-invoice-retrieval-logical-feature-specification.md#33-failure-and-recovery-decisions">
