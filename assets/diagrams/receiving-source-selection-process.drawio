          </mxCell>
        </object>
        <object id="failed-outcome" label="If allowed, get the public copy and use the copy route above.&#10;Otherwise, keep recovery pending." link="../../specs/invoice-receiving/SPEC-SEI-026-invoice-retrieval-logical-feature-specification.md#34-process-review-proposal">
          <mxCell parent="1" vertex="1" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Arial;fontSize=18;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;dashed=1;dashPattern=6 4;">
