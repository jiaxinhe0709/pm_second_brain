          </mxCell>
        </object>
        <object id="copy-action" label="Get the copy from the public platform,&#10;if the company has permission." link="../../specs/invoice-receiving/SPEC-SEI-026-invoice-retrieval-logical-feature-specification.md#34-process-review-proposal">
          <mxCell parent="1" vertex="1" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Arial;fontSize=18;strokeColor=#666666;strokeWidth=1.5;fillColor=#e8e8e8;">
            <mxGeometry as="geometry" x="610" y="525" width="500" height="130" />
          </mxCell>
        </object>
        <object id="copy-outcome" label="Start receiving with the copy.&#10;Allow view/download after the required checks.&#10;ERP delivery waits for the original." link="../../specs/invoice-receiving/SPEC-SEI-026-invoice-retrieval-logical-feature-specification.md#34-process-review-proposal">
          <mxCell parent="1" vertex="1" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Arial;fontSize=18;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;">
