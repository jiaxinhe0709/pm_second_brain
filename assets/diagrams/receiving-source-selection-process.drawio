          </mxCell>
        </object>
        <object id="private-action" label="Get the original from the private platform.&#10;Keep the public copy if it is also obtained." link="../../specs/invoice-receiving/SPEC-SEI-026-invoice-retrieval-logical-feature-specification.md#34-process-review-proposal">
          <mxCell parent="1" vertex="1" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Arial;fontSize=18;strokeColor=#666666;strokeWidth=1.5;fillColor=#e8e8e8;">
