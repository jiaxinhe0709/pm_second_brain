          </mxCell>
        </object>
        <object id="failed-action" label="Keep the original request pending.&#10;Check whether getting a public copy is allowed.&#10;Automatic recovery rules are not agreed yet." link="../../specs/invoice-receiving/SPEC-SEI-026-invoice-retrieval-logical-feature-specification.md#34-process-review-proposal">
          <mxCell parent="1" vertex="1" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Arial;fontSize=18;strokeColor=#666666;strokeWidth=1.5;fillColor=#e8e8e8;dashed=1;dashPattern=6 4;">
