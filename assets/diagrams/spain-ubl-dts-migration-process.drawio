<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device"><diagram id="spain-ubl-dts-migration-process" name="Spain UBL: qualification, consumer cutover and rollback"><mxGraphModel dx="1600" dy="1230" page="1" pageWidth="1600" pageHeight="1230" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Spain UBL: qualification, consumer cutover and rollback" style="text;html=1;fontSize=27;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="1550" height="40" as="geometry" /></mxCell><mxCell id="subtitle" value="Proposed flow • library ownership and service compatibility qualify together" style="text;html=1;fontSize=17;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="60" width="1550" height="30" as="geometry" /></mxCell><mxCell id="lane0" value="Operations / support" style="shape=swimlane;startSize=60;horizontal=1;fillColor=#dedede;swimlaneFillColor=#f6f6f6;strokeColor=#cccccc;fontSize=17;fontStyle=1;noLabel=1;" vertex="1" parent="1"><mxGeometry x="25" y="115" width="440" height="1035" as="geometry" /></mxCell><mxCell id="lane1" value="Domain Service - Other Services" style="shape=swimlane;startSize=60;horizontal=1;fillColor=#dedede;swimlaneFillColor=#f6f6f6;strokeColor=#cccccc;fontSize=17;fontStyle=1;noLabel=1;" vertex="1" parent="1"><mxGeometry x="580" y="115" width="440" height="1035" as="geometry" /></mxCell><mxCell id="lane2" value="Operations / support" style="shape=swimlane;startSize=60;horizontal=1;fillColor=#dedede;swimlaneFillColor=#f6f6f6;strokeColor=#cccccc;fontSize=17;fontStyle=1;noLabel=1;" vertex="1" parent="1"><mxGeometry x="1135" y="115" width="440" height="1035" as="geometry" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4c555c;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m10" target="m11"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4c555c;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m11" target="m12"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" value="qualified" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4c555c;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m12" target="m13"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4c555c;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m13" target="m14"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge4" value="cohort stable" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4c555c;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m14" target="m15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1355" y="690" /><mxPoint x="800" y="690" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4c555c;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m15" target="mend"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge6" value="failed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#a34141;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="m12" target="mfix"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge7" value="repair and requalify" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#a34141;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="mfix" target="m11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="245" y="315" /><mxPoint x="565" y="315" /><mxPoint x="565" y="224" /></Array></mxGeometry></mxCell><mxCell id="edge8" value="gate not met" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#a34141;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="m13" target="mhold"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1095" y="409" /><mxPoint x="1095" y="510" /><mxPoint x="800" y="510" /></Array></mxGeometry></mxCell><mxCell id="edge9" value="incident / regression" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#956720;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="m14" target="mrollback"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="594" /><mxPoint x="1560" y="1014" /></Array></mxGeometry></mxCell><mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#956720;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="mrollback" target="m13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="1014" /><mxPoint x="1580" y="409" /></Array></mxGeometry></mxCell><mxCell id="edge11" value="existing work" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#5d7080;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="mrollback" target="mpinned"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge12" value="separate approval" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#5d7080;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="mend" target="mretire"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="m10" value="UM-10&lt;br&gt;&lt;b&gt;Inventory legacy baseline&lt;/b&gt;&lt;br&gt;Mapper, source contract and consumers" style="rounded=1;arcSize=12;fillColor=#e8e8e8;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="350" height="88" as="geometry" /></mxCell><mxCell id="m11" value="UM-11&lt;br&gt;&lt;b&gt;Integrate DTS capability&lt;/b&gt;&lt;br&gt;Owned mapper, API, routing and XML result" style="rounded=1;arcSize=12;fillColor=#e8e8e8;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="625" y="180" width="350" height="88" as="geometry" /></mxCell><mxCell id="m12" value="UM-12&lt;br&gt;&lt;b&gt;Qualify the release&lt;/b&gt;&lt;br&gt;Parity, old workloads, load and recovery" style="rounded=1;arcSize=12;fillColor=#e8e8e8;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="625" y="365" width="350" height="88" as="geometry" /></mxCell><mxCell id="m13" value="UM-13&lt;br&gt;&lt;b&gt;Compare and switch cohort&lt;/b&gt;&lt;br&gt;Shadow never sends; switch only ready work" style="rounded=1;arcSize=12;fillColor=#e8e8e8;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="365" width="350" height="88" as="geometry" /></mxCell><mxCell id="m14" value="UM-14&lt;br&gt;&lt;b&gt;Observe and decide&lt;/b&gt;&lt;br&gt;Expand, hold or roll back new admissions" style="rounded=1;arcSize=12;fillColor=#e8e8e8;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="550" width="350" height="88" as="geometry" /></mxCell><mxCell id="m15" value="UM-15&lt;br&gt;&lt;b&gt;Accept ownership handover&lt;/b&gt;&lt;br&gt;DTS release, support and maintenance" style="rounded=1;arcSize=12;fillColor=#e8e8e8;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="625" y="735" width="350" height="88" as="geometry" /></mxCell><mxCell id="mend" value="OUTCOME&lt;br&gt;&lt;b&gt;Consumers migrated&lt;/b&gt;&lt;br&gt;Qualified capability and clear ownership" style="rounded=1;arcSize=50;fillColor=#ffffff;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="735" width="350" height="88" as="geometry" /></mxCell><mxCell id="mfix" value="UM-12 → UM-11&lt;br&gt;&lt;b&gt;Resolve qualification gaps&lt;/b&gt;&lt;br&gt;No activation after a failed gate" style="rounded=1;arcSize=12;fillColor=#fff2f2;strokeColor=#a34141;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="365" width="350" height="88" as="geometry" /></mxCell><mxCell id="mhold" value="GATE&lt;br&gt;&lt;b&gt;Hold unapproved use&lt;/b&gt;&lt;br&gt;Contract, profile or consumer not ready" style="rounded=1;arcSize=12;fillColor=#fff2f2;strokeColor=#a34141;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="625" y="550" width="350" height="88" as="geometry" /></mxCell><mxCell id="mrollback" value="UM-14&lt;br&gt;&lt;b&gt;Roll back new work safely&lt;/b&gt;&lt;br&gt;Reconcile first; select qualified prior path" style="rounded=1;arcSize=12;fillColor=#fff5df;strokeColor=#956720;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;shape=octagon;" vertex="1" parent="1"><mxGeometry x="1180" y="970" width="350" height="88" as="geometry" /></mxCell><mxCell id="mpinned" value="UM-03 / 09 / 14&lt;br&gt;&lt;b&gt;Preserve in-flight history&lt;/b&gt;&lt;br&gt;Original operation, bundle and lookups" style="rounded=1;arcSize=12;fillColor=#eef2f5;strokeColor=#5d7080;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="625" y="970" width="350" height="88" as="geometry" /></mxCell><mxCell id="mretire" value="SEPARATE DECISION&lt;br&gt;&lt;b&gt;Review legacy retirement&lt;/b&gt;&lt;br&gt;Drain, history and rollback gates first" style="rounded=1;arcSize=12;fillColor=#eef2f5;strokeColor=#5d7080;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="970" width="350" height="88" as="geometry" /></mxCell><mxCell id="footer0" value="Rollback changes new-work routing only after reconciliation. Existing jobs keep their pinned versions." style="text;html=1;align=left;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="1160" width="1550" height="25" as="geometry" /></mxCell><mxCell id="footer1" value="Future countries need their own qualification. Legacy retirement is an explicit decision after migration." style="text;html=1;align=left;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="1186" width="1550" height="25" as="geometry" /></mxCell><mxCell id="lane0-label" value="&lt;b&gt;Operations / support&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Spain / consumer owners&lt;/span&gt;" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=4;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="115" width="440" height="60" /></mxCell><mxCell id="lane1-label" value="&lt;b&gt;Domain Service -&lt;br&gt;Other Services&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;DTS engineering / QA&lt;/span&gt;" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=4;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="115" width="440" height="60" /></mxCell><mxCell id="lane2-label" value="&lt;b&gt;Operations / support&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;DTS release / operations&lt;/span&gt;" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=4;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1135" y="115" width="440" height="60" /></mxCell></root></mxGraphModel></diagram></mxfile>