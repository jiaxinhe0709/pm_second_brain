<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device"><diagram id="certificate-renewal-recovery-process" name="Certificate renewal, containment and retirement"><mxGraphModel dx="2800" dy="770" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="770" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Certificate renewal, containment and retirement" style="text;html=1;align=left;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="15" width="2750" height="42" /></mxCell><mxCell id="subtitle" value="Logical responsibility groups; exact service owners and implementation remain open in the owning spec." style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="58" width="2750" height="30" /></mxCell><mxCell id="phase0" value="REQUEST &amp; CONTEXT" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="285" y="98" width="585" height="28" as="geometry" /></mxCell><mxCell id="phase1" value="POLICY &amp; AUTHORITY" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="880" y="98" width="585" height="28" as="geometry" /></mxCell><mxCell id="phase2" value="MATERIAL &amp; VALIDATION" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="1475" y="98" width="605" height="28" as="geometry" /></mxCell><mxCell id="phase3" value="RESULT &amp; CONTINUITY" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1">