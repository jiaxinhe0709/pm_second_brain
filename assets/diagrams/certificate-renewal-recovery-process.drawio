vertex="1" parent="1"><mxGeometry as="geometry" x="1382" y="395" width="96" height="22" /></mxCell><mxCell id="c2" value="CERT-08&lt;br&gt;&lt;b&gt;Map dependencies&lt;/b&gt;&lt;br&gt;Owner, routes, queues and history" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="625" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="c3" value="CERT-08&lt;br&gt;&lt;b&gt;Create replacement&lt;/b&gt;&lt;br&gt;New protected material version" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="940" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="c4" value="CERT-04&lt;br&gt;&lt;b&gt;Validate and test&lt;/b&gt;&lt;br&gt;Trust checks and counterpart proof" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1260" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="c6" value="CERT-08&lt;br&gt;&lt;b&gt;Select new version&lt;/b&gt;&lt;br&gt;Future work only; freeze old attempts" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1900" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="c7" value="CERT-10&lt;br&gt;&lt;b&gt;Retire old key&lt;/b&gt;&lt;br&gt;Dependency and hold checks" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2220" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="c8" value="END&lt;br&gt;&lt;b&gt;Preserve proof&lt;/b&gt;&lt;br&gt;Old signed evidence remains" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2540" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="ch1" value="CERT-09&lt;br&gt;&lt;b&gt;Contain affected scope&lt;/b&gt;&lt;br&gt;Compromise or revoked trust" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="625" y="332" width="230" height="100" as="geometry" /></mxCell><mxCell id="c1" value="START&lt;br&gt;&lt;b&gt;Detect change&lt;/b&gt;&lt;br&gt;Expiry, revocation or compromise" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="310" y="510" width="230" height="100" as="geometry" /></mxCell><mxCell id="c5" value="DECISION&lt;br&gt;&lt;b&gt;Cutover approved?&lt;/b&gt;&lt;br&gt;Policy, overlap and effective time" style="rhombus;fillColor=#d7d7d7;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1580" y="510" width="240" height="110" as="geometry" /></mxCell><mxCell id="ch2" value="HOLD&lt;br&gt;&lt;b&gt;Resolve failed test&lt;/b&gt;&lt;br&gt;Old use only if still safe" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1260" y="510" width="230" height="100" as="geometry" /></mxCell><mxCell id="footer" value="New versions cut over only after validation; compromised material is contained without erasing historic proof. Rotation changes future selection, not an in-flight operation. Revocation/compromise stops affected new use; key destruction and evidence retention are separate gates." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="695" width="2750" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>