ntColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.7307692307692307;exitY=1.0;entryX=0.6333333333333333;entryY=0.0;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=7 5;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-13" value="owned recovery" source="unresolved" target="l10" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2460" y="995" /><mxPoint x="2460" y="815" /></Array></mxGeometry></mxCell><mxCell id="l1" value="RLU-01&lt;br&gt;&lt;b&gt;Accept EARLY / FINAL&lt;/b&gt;&lt;br&gt;Exact request and use" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="310" y="178" width="260" height="86" /></mxCell><mxCell id="l2" value="RLU-02&lt;br&gt;&lt;b&gt;Check identity and access&lt;/b&gt;&lt;br&gt;Recipient distinct from issuer" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="350" width="260" height="86" /></mxCell><mxCell id="l3" value="RLU-03&lt;br&gt;&lt;b&gt;Select source policy&lt;/b&gt;&lt;br&gt;Coverage and freshness" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="548" width="260" height="86" /></mxCell><mxCell id="l4" value="RLU-04&lt;br&gt;&lt;b&gt;Reuse or coalesce refresh&lt;/b&gt;&lt;br&gt;Scope, age and generation" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1240" y="350" width="260" height="86" /></mxCell><mxCell id="l5" value="RLU-05&lt;br&gt;&lt;b&gt;Query approved sources&lt;/b&gt;&lt;br&gt;Timeout is not absence" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1550" y="548" width="260" height="86" /></mxCell><mxCell id="l6" value="RLU-06&lt;br&gt;&lt;b&gt;Preserve candidates / conflicts&lt;/b&gt;&lt;br&gt;Source and completeness" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1860" y="350" width="260" height="86" /></mxCell><mxCell id="l7" value="RLU-07&lt;br&gt;&lt;b&gt;Qualify destination / selection&lt;/b&gt;&lt;br&gt;Receiving and interconnection" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="2170" y="548" width="260" height="86" /></mxCell><mxCell id="l8" value="RLU-08&lt;br&gt;&lt;b&gt;Commit decision evidence&lt;/b&gt;&lt;br&gt;Immutable snapshot / version" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="2480" y="350" width="260" height="86" /></mxCell><mxCell id="l9" value="RLU-09&lt;br&gt;&lt;b&gt;Return to consumer&lt;/b&gt;&lt;br&gt;Final-use recheck required" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="2840" y="178" width="260" height="86" /></mxCell><mxCell id="ready" value="PRIVATE_READY&lt;br&gt;&lt;b&gt;Qualified receiving point&lt;/b&gt;&lt;br&gt;Selected by approved policy" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="2830" y="740" width="300" height="86" /></mxCell><mxCell id="public" value="PUBLIC_ROUTE_SUPPORTED&lt;br&gt;&lt;b&gt;Sufficient approved basis&lt;/b&gt;&lt;br&gt;No inferred global absence" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="2830" y="848" width="300" height="86" /></mxCell><mxCell id="unresolved" value="UNRESOLVED / NOT READY&lt;br&gt;&lt;b&gt;Failed, stale, partial, ambiguous&lt;/b&gt;&lt;br&gt;or private point ineligible&lt;br&gt;Final dispatch held" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="2480" y="945" width="300" height="100" /></mxCell><mxCell id="l10" value="RLU-10&lt;br&gt;&lt;b&gt;Recover / invalidate / evolve&lt;/b&gt;&lt;br&gt;Bounded refresh or reviewed&lt;br&gt;manual evidence; keep history" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="2130" y="755" width="300" height="120" /></mxCell><mxCell id="footer" value="Early lookup is advisory. Failed or partial negative lookup cannot select the public route. New evidence never rewrites a sent plan." style="text;html=1;fontSize=12;align=left;strokeColor=none;fillColor=none;fontColor=#444444;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1060" width="3150" height="30" /></mxCell></root></mxGraphModel></diagram></mxfile>