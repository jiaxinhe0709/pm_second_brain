" y="322" /><mxPoint x="2120" y="710" /></Array></mxGeometry></mxCell><mxCell id="label-edge-6" value="candidate check" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2127" y="505" width="90.5" height="22" /></mxCell><mxCell id="edge-7" value="" source="l6" target="l8" parent="1" edge="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=7 5;" workflowLabel="absence evidence"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="label-edge-7" value="absence evidence" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2252" y="225" width="96" height="22" /></mxCell><mxCell id="edge-8" value="" source="l7" target="l8" parent="1" edge="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=7 5;" workflowLabel="eligibility evidence"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2440" y="710" /><mxPoint x="2440" y="252" /></Array></mxGeometry></mxCell><mxCell id="label-edge-8" value="eligibility evidence" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2447" y="470" width="118" height="22" /></mxCell><mxCell id="edge-9" value="" source="l8" target="l9" parent="1" edge="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=7 5;" workflowLabel="saved decision"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2820" y="252" /><mxPoint x="2820" y="532" /></Array></mxGeometry></mxCell><mxCell id="label-edge-9" value="saved decision" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2827" y="451" width="85" height="22" /></mxCell><mxCell id="edge-10" value="" source="l8" target="ready" parent="1" edge="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=7 5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-11" value="" source="l8" target="public" parent="1" edge="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=7 5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2820" y="252" /><mxPoint x="2820" y="382" /></Array></mxGeometry></mxCell><mxCell id="edge-12" value="" source="l8" target="unresolved" parent="1" edge="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=7 5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2610" y="322" /><mxPoint x="2630" y="322" /></Array></mxGeometry></mxCell><mxCell id="edge-13" value="" source="unresolved" target="l10" parent="1" edge="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" workflowLabel="owned recovery"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2470" y="382" /><mxPoint x="2470" y="392" /></Array></mxGeometry></mxCell><mxCell id="label-edge-13" value="owned recovery" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2432.5" y="174" width="85" height="22" /></mxCell><mxCell id="l1" value="&lt;b&gt;Request a recipient lookup&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Early (EARLY) or final (FINAL) check&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RLU-01&lt;/span&gt;" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="310" y="202" width="260" height="100" /></mxCell><mxCell id="l2" value="&lt;b&gt;Check identity and permission&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep recipient and issuer distinct&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RLU-02&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="202" width="260" height="100" /></mxCell><mxCell id="l4" value="&lt;b&gt;Reuse valid evidence or share a refresh&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Same scope, age and request version&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RLU-04&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="1240" y="202" width="260" height="100" /></mxCell><mxCell id="l6" value="&lt;b&gt;Save possible destinations and conflicts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep source and coverage evidence&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RLU-06&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="1860" y="202" width="260" height="100" /></mxCell><mxCell id="l8" value="&lt;b&gt;Save the lookup decision evidence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep the fixed snapshot and version&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RLU-08&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2480" y="202" width="260" height="100" /></mxCell><mxCell id="l9" value="&lt;b&gt;Return the decision to the service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Recheck before final use&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RLU-09&lt;/span&gt;" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2840" y="482" width="260" height="100" /></mxCell><mxCell id="ready" value="&lt;b&gt;Private receiving destination ready&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Selected under the approved rules&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;PRIVATE_READY&lt;/span&gt;" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2830" y="202" width="300" height="100" /></mxCell><mxCell id="public" value="&lt;b&gt;Public route has sufficient evidence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Do not infer global absence&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;PUBLIC_ROUTE_SUPPORTED&lt;/span&gt;" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2830" y="332" width="300" height="100" /></mxCell><mxCell id="unresolved" value="&lt;b&gt;Hold an unresolved destination&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Failed, stale, partial or conflicting evidence&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;UNRESOLVED / NOT READY&lt;/span&gt;" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2480" y="332" width="300" height="100" /></mxCell><mxCell id="l10" value="&lt;b&gt;Recover or refresh lookup evidence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Approved limits; keep earlier decisions&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RLU-10&lt;/span&gt;" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2130" y="332" width="300" height="120" /></mxCell><mxCell id="l3" value="&lt;b&gt;Select the approved lookup rules&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Source coverage and evidence freshness&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RLU-03&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="660" width="260" height="100" /></mxCell><mxCell id="l5" value="&lt;b&gt;Query the approved sources&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;A timeout does not prove absence&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RLU-05&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="1550" y="660" width="260" height="100" /></mxCell><mxCell id="l7" value="&lt;b&gt;Check destination readiness and choice&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Receiving and platform interconnection&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;RLU-07&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2170" y="660" width="260" height="100" /></mxCell><mxCell id="footer" value="Early lookup is advisory. Failed or partial negative lookup cannot select the public route. New evidence never rewrites a sent plan." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="835" width="3150" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>