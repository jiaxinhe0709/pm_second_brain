mily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="1240" y="202" width="260" height="100" /></mxCell><mxCell id="l6" value="RLU-06&lt;br&gt;&lt;b&gt;Preserve candidates / conflicts&lt;/b&gt;&lt;br&gt;Source and completeness" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="1860" y="202" width="260" height="100" /></mxCell><mxCell id="l8" value="RLU-08&lt;br&gt;&lt;b&gt;Commit decision evidence&lt;/b&gt;&lt;br&gt;Immutable snapshot / version" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2480" y="202" width="260" height="100" /></mxCell><mxCell id="l9" value="RLU-09&lt;br&gt;&lt;b&gt;Return to consumer&lt;/b&gt;&lt;br&gt;Final-use recheck required" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2840" y="482" width="260" height="100" /></mxCell><mxCell id="ready" value="PRIVATE_READY&lt;br&gt;&lt;b&gt;Qualified receiving point&lt;/b&gt;&lt;br&gt;Selected by approved policy" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2830" y="202" width="300" height="100" /></mxCell><mxCell id="public" value="PUBLIC_ROUTE_SUPPORTED&lt;br&gt;&lt;b&gt;Sufficient approved basis&lt;/b&gt;&lt;br&gt;No inferred global absence" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2830" y="332" width="300" height="100" /></mxCell><mxCell id="unresolved" value="UNRESOLVED / NOT READY&lt;br&gt;&lt;b&gt;Failed, stale, partial, ambiguous&lt;/b&gt;&lt;br&gt;or private point ineligible&lt;br&gt;Final dispatch held" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2480" y="332" width="300" height="100" /></mxCell><mxCell id="l10" value="RLU-10&lt;br&gt;&lt;b&gt;Recover / invalidate / evolve&lt;/b&gt;&lt;br&gt;Bounded refresh or reviewed&lt;br&gt;manual evidence; keep history" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2130" y="332" width="300" height="120" /></mxCell><mxCell id="l3" value="RLU-03&lt;br&gt;&lt;b&gt;Select source policy&lt;/b&gt;&lt;br&gt;Coverage and freshness" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="660" width="260" height="100" /></mxCell><mxCell id="l5" value="RLU-05&lt;br&gt;&lt;b&gt;Query approved sources&lt;/b&gt;&lt;br&gt;Timeout is not absence" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="1550" y="660" width="260" height="100" /></mxCell><mxCell id="l7" value="RLU-07&lt;br&gt;&lt;b&gt;Qualify destination / selection&lt;/b&gt;&lt;br&gt;Receiving and interconnection" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2170" y="660" width="260" height="100" /></mxCell><mxCell id="footer" value="Early lookup is advisory. Failed or partial negative lookup cannot select the public route. New evidence never rewrites a sent plan." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="835" width="3150" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>