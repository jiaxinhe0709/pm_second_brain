        <mxCell id="issuance-note" value="ERP owns issuance. Coordinate the required public copy with issuance, not with successful private delivery (OUT-Q03)." vertex="1" parent="1" style="text;html=0;align=left;fontSize=18;fontColor=#444;">
          <mxGeometry as="geometry" x="55" y="837" width="1890" height="28" />
        </mxCell>
        <mxCell id="action-note" value="Unresolved route: hold dispatch. Action observations are independent; the results box is not a completion join." vertex="1" parent="1" style="text;html=0;align=left;fontSize=18;fontColor=#444;">
          <mxGeometry as="geometry" x="55" y="867" width="1890" height="28" />
        </mxCell>
        <mxCell id="issued-note" value="Already-issued paths retain proof. Late-copy recovery does not redefine the normal issuance boundary." vertex="1" parent="1" style="text;html=0;align=left;fontSize=18;fontColor=#444;">
          <mxGeometry as="geometry" x="55" y="897" width="1890" height="28" />
        </mxCell>
        <mxCell id="exception-note" value="If work is blocked or uncertain&#10;Hold the affected action, preserve known results and return an owned next step. Reconcile possible external effects before repetition." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;spacing=16;fontSize=18;align=left;fillColor=#f5f5f5;strokeColor=#aaaaaa;">
          <mxGeometry as="geometry" x="55" y="960" width="1890" height="90" />
        </mxCell>
