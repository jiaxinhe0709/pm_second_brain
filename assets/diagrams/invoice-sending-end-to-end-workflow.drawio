          </mxCell>
        </object>
        <object id="pdf" label="Local product generates PDF when required&#10;Send to buyer via a qualified private attachment or a separate channel. Never send this PDF to the public platform.&#10;" link="../../specs/invoice-sending/SPEC-SEI-023-invoice-sending-logical-feature-specification.md#3-process-and-activity-order">
