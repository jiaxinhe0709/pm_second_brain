          </mxCell>
        </object>
        <object label="Private recipient delivery&#xa;Structured invoice to the recipient&#39;s private platform&#xa;" link="../../specs/invoice-sending/SPEC-SEI-023-invoice-sending-logical-feature-specification.md#3-process-and-activity-order" id="private">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=17;spacing=12;fillColor=#f1f1f1;strokeColor=#555555;" vertex="1">
            <mxGeometry height="115" width="430" x="1216.26" y="350" as="geometry" />
          </mxCell>
        </object>
        <object label="Faithful copy to the public platform&#xa;&#xa;Separate action: the domain service derives the required public-copy payload from the complete UBL invoice generated by the local ERP, then calls the selected private platform’s existing submission capability.&#xa;" link="../../specs/invoice-sending/SPEC-SEI-023-invoice-sending-logical-feature-specification.md#3-process-and-activity-order" id="copy">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=17;spacing=12;fillColor=#f1f1f1;strokeColor=#555555;fontStyle=0" vertex="1">
            <mxGeometry height="170" width="430" x="1216.26" y="503" as="geometry" />
          </mxCell>
        </object>
        <object label="Public recipient delivery&#xa;Structured invoice through public platform; no extra copy&#xa;" link="../../specs/invoice-sending/SPEC-SEI-023-invoice-sending-logical-feature-specification.md#3-process-and-activity-order" id="public">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=17;spacing=12;fillColor=#f1f1f1;strokeColor=#555555;" vertex="1">
            <mxGeometry height="115" width="430" x="1216.26" y="720" as="geometry" />
          </mxCell>
        </object>
        <object label="Separate results&#xa;Recipient delivery, public copy and PDF delivery each keep their own result&#xa;" link="../../specs/invoice-sending/SPEC-SEI-023-invoice-sending-logical-feature-specification.md#3-process-and-activity-order" id="results">
          <mxCell parent="1" style="rounded=1;arcSize=80;whiteSpace=wrap;html=0;fontSize=17;spacing=12;fillColor=#e6e6e6;strokeColor=#555555;" vertex="1">
            <mxGeometry height="200" width="305" x="1736.26" y="490" as="geometry" />
          </mxCell>
        </object>
        <object label="Local product generates PDF when required&#xa;Send to buyer via a qualified private attachment or a separate channel. Never send this PDF to the public platform.&#xa;" link="../../specs/invoice-sending/SPEC-SEI-023-invoice-sending-logical-feature-specification.md#3-process-and-activity-order" id="pdf">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=17;spacing=12;fillColor=#fafafa;strokeColor=#555555;" vertex="1">
            <mxGeometry height="125" width="640" x="55" y="940" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="issuance-note" parent="1" style="text;html=0;align=left;fontSize=18;fontColor=#444;" value="ERP owns issuance. Coordinate the required public copy with issuance, not with successful private delivery (OUT-Q03)." vertex="1">
          <mxGeometry height="28" width="1890" x="55" y="1097" as="geometry" />
        </mxCell>
        <mxCell id="action-note" parent="1" style="text;html=0;align=left;fontSize=18;fontColor=#444;" value="Unresolved route: hold dispatch. Action observations are independent; the results box is not a completion join." vertex="1">
          <mxGeometry height="28" width="1890" x="55" y="1127" as="geometry" />
        </mxCell>
        <mxCell id="issued-note" parent="1" style="text;html=0;align=left;fontSize=18;fontColor=#444;" value="Already-issued paths retain proof. Late-copy recovery does not redefine the normal issuance boundary." vertex="1">
          <mxGeometry height="28" width="1890" x="55" y="1157" as="geometry" />
        </mxCell>
        <mxCell id="exception-note" parent="1" style="rounded=1;whiteSpace=wrap;html=0;spacing=16;fontSize=18;align=left;fillColor=#f5f5f5;strokeColor=#aaaaaa;" value="If work is blocked or uncertain&#xa;Hold the affected action, preserve known results and return an owned next step. Reconcile possible external effects before repetition." vertex="1">
          <mxGeometry height="90" width="1890" x="55" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="footer-0" parent="1" style="text;html=0;align=left;fontSize=17;fontColor=#555;" value="One invoice for a business user or authorised accountant. Detailed rules and PDF applicability remain in SEI023 / PRD-SEI-246." vertex="1">
