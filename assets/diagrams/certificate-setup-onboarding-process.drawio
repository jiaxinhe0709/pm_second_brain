Cell id="a2" value="CERT-01&lt;br&gt;&lt;b&gt;Classify need&lt;/b&gt;&lt;br&gt;Policy, route and profile" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="610" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="a3" value="DECISION&lt;br&gt;&lt;b&gt;Certificate needed?&lt;/b&gt;&lt;br&gt;Required, not required or unknown" style="rhombus;fillColor=#d7d7d7;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1210" y="558" width="240" height="110" as="geometry" /></mxCell><mxCell id="a4" value="CERT-02&lt;br&gt;&lt;b&gt;Verify authority&lt;/b&gt;&lt;br&gt;Principal, delegate and scope" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="910" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="a5" value="CERT-03&lt;br&gt;&lt;b&gt;Establish custody&lt;/b&gt;&lt;br&gt;Protected version or reference" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1510" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="a6" value="CERT-04&lt;br&gt;&lt;b&gt;Validate material&lt;/b&gt;&lt;br&gt;Owner, purpose, chain, status" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1810" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="a7" value="CERT-05&lt;br&gt;&lt;b&gt;Decide readiness&lt;/b&gt;&lt;br&gt;Scoped result and recheck" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2110" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="ah1" value="HOLD&lt;br&gt;&lt;b&gt;Policy decision&lt;/b&gt;&lt;br&gt;Unknown requirement; owner assigned" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1210" y="746" width="240" height="100" as="geometry" /></mxCell><mxCell id="ah3" value="RECOVER&lt;br&gt;&lt;b&gt;Remediate or reconcile&lt;/b&gt;&lt;br&gt;Invalid or unknown trust" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1810" y="746" width="230" height="100" as="geometry" /></mxCell><mxCell id="footer" value="One legal subject and capability: conditional certificate need, independent authority and purpose-specific readiness. Solid arrows show the selected path. Dashed branches are policy, authority or trust action. A ready result never implies route activation." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="921" width="2750" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>