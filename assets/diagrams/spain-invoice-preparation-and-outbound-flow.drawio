        </mxCell>
        <mxCell id="34" value="&lt;b&gt;Check an uncertain action&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Use the original action before retrying&lt;/span&gt;" style="shape=hexagon;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#444444;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2710" y="660" width="250" height="100" />
        </mxCell>
        <mxCell id="24" value="&lt;b&gt;Find the recipient&amp;#x27;s destination&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Use current authoritative evidence&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;09&lt;/span&gt;" style="shape=rhombus;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#ededed;strokeColor=#444444;strokeWidth=2;" vertex="1" parent="1">
