        <mxCell id="22" value="&lt;b&gt;Does the draft pass validation?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;04&lt;/span&gt;" style="shape=rhombus;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#ededed;strokeColor=#444444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="790" y="510" width="190" height="120" />
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;Check final candidate&lt;/b&gt;&lt;br&gt;Exact facts, authority, profile&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;08&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#ededed;strokeColor=#444444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1500" y="510" width="210" height="100" />
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;Freeze exchange plan&lt;/b&gt;&lt;br&gt;Route, trust and actions&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;10&lt;/span&gt;" style="shape=document;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#444444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2030" y="510" width="210" height="100" />
        </mxCell>
        <mxCell id="26" value="&lt;b&gt;Prepare final files&lt;/b&gt;&lt;br&gt;Validate, trust and save intent&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;11&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#ededed;strokeColor=#444444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2290" y="510" width="210" height="100" />
        </mxCell>
        <mxCell id="27" value="&lt;b&gt;Save each action&amp;#x27;s result&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep the raw outcomes separate&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;13&lt;/span&gt;" style="shape=cylinder;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#444444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2710" y="510" width="200" height="110" />
        </mxCell>
        <mxCell id="28" value="&lt;b&gt;Update status views&lt;/b&gt;&lt;br&gt;Evidence and next action&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;14&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#ededed;strokeColor=#444444;strokeWidth=2;" vertex="1" parent="1">
