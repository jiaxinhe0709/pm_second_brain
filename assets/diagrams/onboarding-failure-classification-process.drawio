idth="230" height="100" as="geometry" /></mxCell><mxCell id="a1" value="OFR-01&lt;br&gt;&lt;b&gt;Capture attempt&lt;/b&gt;&lt;br&gt;Durable intent and correlation" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="310" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="a2" value="OFR-02&lt;br&gt;&lt;b&gt;Classify result&lt;/b&gt;&lt;br&gt;Fault, safety and next action" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="660" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="a3" value="DECISION&lt;br&gt;&lt;b&gt;Safe to retry?&lt;/b&gt;&lt;br&gt;Approved contract or read-only" style="rhombus;fillColor=#d7d7d7;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1010" y="558" width="240" height="110" as="geometry" /></mxCell><mxCell id="a4" value="OFR-04&lt;br&gt;&lt;b&gt;Schedule retry&lt;/b&gt;&lt;br&gt;Same identity and budget" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="a5" value="OFR-08&lt;br&gt;&lt;b&gt;Publish outcome&lt;/b&gt;&lt;br&gt;One client item and aggregate" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1710" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="a8" value="OFR-05&lt;br&gt;&lt;b&gt;Hold unknown&lt;/b&gt;&lt;br&gt;Possible external mutation" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="698" width="230" height="100" as="geometry" /></mxCell><mxCell id="a9" value="OFR-07&lt;br&gt;&lt;b&gt;Escalate owned case&lt;/b&gt;&lt;br&gt;Budget or contract unresolved" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1710" y="876" width="230" height="100" as="geometry" /></mxCell><mxCell id="footer" value="Business fault and operation safety are independent decisions for one entity and capability. Transport status alone never authorises a retry. Unknown mutations reconcile before repetition; mixed portfolio items remain independent." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1051" width="2750" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>