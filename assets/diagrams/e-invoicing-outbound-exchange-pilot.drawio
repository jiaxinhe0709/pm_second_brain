<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device"><diagram id="outbound-pilot" name="Outbound invoice exchange"><mxGraphModel dx="2620" dy="1559" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2620" pageHeight="1559" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Prepare and send invoices; track each action" style="text;html=1;align=left;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="15" width="2570" height="42" /></mxCell><mxCell id="subtitle" value="Logical responsibility groups; exact service owners and implementation remain open in the owning spec." style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="58" width="2570" height="30" /></mxCell><mxCell id="phase0" value="CHECK REQUEST &amp; PERMISSION" style="shape=rectangle;rounded=1;arcSize=8;fillColor=#d0d0d0;strokeColor=none;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="285" y="96" width="550" height="28" as="geometry" /></mxCell><mxCell id="phase1" value="PLAN &amp; CHECK SIGNING RULES" style="shape=rectangle;rounded=1;arcSize=8;fillColor=#d0d0d0;strokeColor=none;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="850" y="96" width="550" height="28" as="geometry" /></mxCell><mxCell id="phase2" value="SEND EACH ACTION" style="shape=rectangle;rounded=1;arcSize=8;fillColor=#d0d0d0;strokeColor=none;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1415" y="96" width="580" height="28" as="geometry" /></mxCell><mxCell id="phase3" value="SAVE RESULTS" style="shape=rectangle;rounded=1;arcSize=8;fillColor=#d0d0d0;strokeColor=none;fon