/span&gt;" style="shape=hexagon;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#222222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="870" y="202" width="250" height="100" as="geometry" /></mxCell><mxCell id="B1" value="&lt;b&gt;Request invoice sending&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Issuer, recipient and source revision&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;01&lt;/span&gt;" style="shape=ellipse;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="310" y="380" width="250" height="100" as="geometry" /></mxCell><mxCell id="B2" value="&lt;b&gt;Correct and resubmit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Validate a new source revision&lt;/span&gt;" style="shape=parallelogram;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="590" y="380" width="250" height="100" as="geometry" /></mxCell><mxCell id="B3" value="&lt;b&gt;Show results and required actions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Evidence, history and responsible owner&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;12&lt;/span&gt;" style="shape=parallelogram;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2330" y="380" width="250" height="100" as="geometry" /></mxCell><mxCell id="S1" value="&lt;b&gt;Receive and check permission&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Customer, business, actor and request ID&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;02&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="310" y="558" width="250" height="100" as="geometry" /></mxCell><mxCell id="S3" value="&lt;b&gt;Is the invoice route ready?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Verified recipient and supported process&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;05&lt;/span&gt;" style="shape=rhombus;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d1d1d1;strokeColor=#222222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="870" y="558" width="250" height="110" as="geometry" /></mxCell><mxCell id="S4" value="&lt;b&gt;Plan and prepare the final invoice&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Fix route; convert, validate and sign if needed&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;06–07&lt;/span&gt;" style="shape=document;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1150" y="558" width="250" height="100" as="geometry" /></mxCell><mxCell id="S5" value="&lt;b&gt;Send each planned action&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Save attempt and external request reference&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;08&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1430" y="558" width="250" height="100" as="geometry" /></mxCell><mxCell id="S6" value="&lt;b&gt;Save each action&amp;#x27;s result&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep the raw result for each action&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;10&lt;/span&gt;" style="shape=cylinder;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#333333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;spacingTop=24;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2050" y="558" width="250" height="100" as="geometry" /></mxCell><mxCell id="S7" value="&lt;b&gt;Update the invoice status view&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep delivery, reports and buyer decision separate&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;11&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2330" y="558" width="250" height="100" as="geometry" /></mxCell><mxCell id="P5" value="&lt;b&gt;Is the outcome unknown?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Check the original action before retrying&lt;/span&gt;" style="shape=hexagon;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#222222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2050" y="698" width="250" height="100" as="geometry" /></mxCell><mxCell id="S2" value="&lt;b&gt;Validate the invoice content&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Identity, format, profile and safety&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;04&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="590" y="876" width="250" height="100" as="geometry" /></mxCell><mxCell id="P1" value="&lt;b&gt;Check the applicable Spain rules&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Country, date, customer group and duties&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;03&lt;/span&gt;" style="shape=document;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="310" y="876" width="250" height="100" as="geometry" /></mxCell><mxCell id="P2" value="&lt;b&gt;Provide approved validation rules&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Versioned format and policy rules&lt;/span&gt;" style="shape=document;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="590" y="1006" width="250" height="100" as="geometry" /></mxCell><mxCell id="P3" value="&lt;b&gt;Provide recipient-route evidence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Ready connection and current receiving point&lt;/span&gt;" style="shape=cylinder;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#333333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;spacingTop=24;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="870" y="876" width="250" height="100" as="geometry" /></mxCell><mxCell id="P4" value="&lt;b&gt;Provide format and signing rules&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Signer, mapping and rule versions&lt;/span&gt;" style="shape=document;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1150" y="876" width="250" height="100" as="geometry" /></mxCell><mxCell id="X1" value="&lt;b&gt;Deliver to the recipient&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Public, private or Peppol route&lt;/span&gt;" style="shape=trapezoid;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1730" y="1232" width="270" height="64" as="geometry" /></mxCell><mxCell id="X2" value="&lt;b&gt;Submit a required copy or report&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Separate duty under the country rules&lt;/span&gt;" style="shape=trapezoid;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1730" y="1322" width="270" height="64" as="geometry" /></mxCell><mxCell id="footer" value="One left-to-right service path with short business and policy branches and a contained split to recipient delivery and a separate required copy or reporting action." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1484" width="2570" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>