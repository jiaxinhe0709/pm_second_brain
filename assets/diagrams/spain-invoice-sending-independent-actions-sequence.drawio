        </mxCell>
        <mxCell id="cell-44" value="Qualify DTS where transformation is needed.&#10;Validate final bytes after transformation; sign or&#10;seal only when required. Protected-operation&#10;uncertainty must reconcile before repetition." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="809" y="1839" width="504.99999999999994" height="93" />
