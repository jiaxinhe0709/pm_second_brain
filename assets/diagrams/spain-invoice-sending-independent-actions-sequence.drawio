        </mxCell>
        <mxCell id="cell-38" value="Failed, stale or ambiguous lookup holds dispatch. It cannot select the public&#10;recipient route. Final validation or policy failure also stops external actions." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="1455" width="800.8" height="49" />
        </mxCell>
