        <mxCell id="cell-35" value="Save final intent and stable exchange identity.&#10;Same key and input resume the existing exchange;&#10;changed input conflicts. Request receipt is not&#10;delivery." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="722" width="485.28" height="93" />
