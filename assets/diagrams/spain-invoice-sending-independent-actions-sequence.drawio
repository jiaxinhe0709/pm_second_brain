          <mxGeometry as="geometry" x="30" y="250" width="975" height="92" />
        </mxCell>
        <mxCell id="cell-30" value="Precondition: ERP supplies stable final candidate facts and planned identity before issuance. Any change&#10;invalidates preparation. Actual coordination needs OUT-Q03 evidence." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="44" y="258" width="1037.4399999999998" height="49" />
        </mxCell>
        <mxCell id="cell-31" value="OUT-05/07 · Draft preparation is outside this sequence" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="44" y="318" width="387.84" height="22" />
        </mxCell>
        <mxCell id="cell-32" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#444444;strokeColor=#444444;">
          <mxGeometry as="geometry" x="28" y="449" width="1744" height="36" />
        </mxCell>
        <mxCell id="cell-33" value="1 · Accept exact final candidate; qualify route and representation before issuance" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#ffffff;spacing=0;">
          <mxGeometry as="geometry" x="40" y="456" width="868.0799999999999" height="28" />
        </mxCell>
        <mxCell id="cell-34" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="540" y="714" width="465" height="138" />
        </mxCell>
        <mxCell id="cell-35" value="Save final intent and stable exchange identity.&#10;Same key and input resume the existing exchange;&#10;changed input conflicts. Request receipt is not&#10;delivery." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="722" width="485.28" height="93" />
        </mxCell>
        <mxCell id="cell-36" value="OUT-07 · OUT-D01 / OUT-D02" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="828" width="192.95999999999998" height="22" />
        </mxCell>
        <mxCell id="cell-37" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#ededed;strokeColor=#888888;dashed=1;">
          <mxGeometry as="geometry" x="540" y="1447" width="720" height="92" />
        </mxCell>
        <mxCell id="cell-38" value="Failed, stale or ambiguous lookup holds dispatch. It cannot select the public&#10;recipient route. Final validation or policy failure also stops external actions." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="1455" width="800.8" height="49" />
        </mxCell>
        <mxCell id="cell-39" value="OUT-08/09 · Hold the unissued candidate for ERP resolution" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="1515" width="415.67999999999995" height="22" />
        </mxCell>
        <mxCell id="cell-40" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="540" y="1594" width="720" height="92" />
        </mxCell>
        <mxCell id="cell-41" value="Freeze the qualified plan and route version. Record delivery and PUBLIC_COPY as&#10;separate actions, with their own destinations, identities and dependencies." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="1602" width="790.9399999999999" height="49" />
        </mxCell>
        <mxCell id="cell-42" value="OUT-10 · OUT-INT-06 · Copy exists only if Spain policy requires it" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="1662" width="471.35999999999996" height="22" />
        </mxCell>
        <mxCell id="cell-43" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="795" y="1831" width="465" height="138" />
        </mxCell>
        <mxCell id="cell-44" value="Qualify DTS where transformation is needed.&#10;Validate final bytes after transformation; sign or&#10;seal only when required. Protected-operation&#10;uncertainty must reconcile before repetition." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="809" y="1839" width="504.99999999999994" height="93" />
        </mxCell>
        <mxCell id="cell-45" value="OUT-11 · DTS is a reuse candidate, not proven coverage" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="809" y="1945" width="387.84" height="22" />
        </mxCell>
        <mxCell id="cell-46" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="540" y="2114" width="720" height="92" />
        </mxCell>
        <mxCell id="cell-47" value="Save final artefact references and send intent. Before each transmission, save&#10;its attempt, payload hash, target, contract version and original correlation." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="2122" width="781.0799999999999" height="49" />
        </mxCell>
        <mxCell id="cell-48" value="OUT-11/12 · OUT-D06 / OUT-D07" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="2182" width="213.83999999999997" height="22" />
        </mxCell>
        <mxCell id="cell-49" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#444444;strokeColor=#444444;">
          <mxGeometry as="geometry" x="28" y="2313" width="1744" height="36" />
        </mxCell>
        <mxCell id="cell-50" value="2 · Coordinate issuance and required copy; retain separate action results" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#ffffff;spacing=0;">
          <mxGeometry as="geometry" x="40" y="2320" width="774.1199999999999" height="28" />
        </mxCell>
        <mxCell id="cell-51" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="30" y="2648" width="1230" height="92" />
        </mxCell>
        <mxCell id="cell-52" value="ERP owns actual issuance. Required copy submission is simultaneous under Article 4. A durable intent alone does not prove compliance. AEAT&#10;admission is a later independent fact." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="44" y="2656" width="1372.6799999999998" height="49" />
        </mxCell>
        <mxCell id="cell-53" value="OUT-06/12 · Final changes block the boundary before issuance" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="44" y="2716" width="429.59999999999997" height="22" />
        </mxCell>
        <mxCell id="cell-54" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#ededed;strokeColor=#888888;dashed=1;">
          <mxGeometry as="geometry" x="1050" y="2975" width="720" height="115" />
        </mxCell>
        <mxCell id="cell-55" value="Example exception: no reliable response arrives after possible transmission.&#10;Preserve actual ERP issue evidence. Copy outcome is unknown, not confirmed&#10;rejection." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="1064" y="2983" width="761.3599999999999" height="71" />
        </mxCell>
        <mxCell id="cell-56" value="OUT-13 · Lost-response scenario" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="1064" y="3066" width="227.76" height="22" />
        </mxCell>
        <mxCell id="cell-57" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#ededed;strokeColor=#888888;dashed=1;">
          <mxGeometry as="geometry" x="540" y="3235" width="720" height="115" />
        </mxCell>
        <mxCell id="cell-58" value="Physical coordination must qualify races and partial failures. An issued invoice&#10;cannot be rolled back automatically, withdrawn or reissued to recover a lost copy&#10;response." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3243" width="810.66" height="71" />
        </mxCell>
        <mxCell id="cell-59" value="OUT-Q03 · Owned recovery; no blind replay" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3326" width="297.35999999999996" height="22" />
        </mxCell>
        <mxCell id="edge-60" edge="1" parent="1" style="edgeStyle=none;rounded=0;strokeColor=#555555;endArrow=none;dashed=1;">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="25" y="3431" />
            <mxPoint as="targetPoint" x="1775" y="3431" />
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cell-61" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=white;strokeColor=none;">
          <mxGeometry as="geometry" x="31" y="3436" width="1738" height="29" />
        </mxCell>
        <mxCell id="cell-62" value="Separate recipient action · Public-copy submission never waits for successful private delivery" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="39" y="3441" width="829.8" height="25" />
        </mxCell>
        <mxCell id="cell-63" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="540" y="3861" width="720" height="92" />
        </mxCell>
        <mxCell id="cell-64" value="Save and expose independent results. Keep confirmed recipient delivery while copy&#10;outcome is unknown. Do not repeat the delivery or blindly resubmit the copy." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3869" width="810.66" height="49" />
        </mxCell>
        <mxCell id="cell-65" value="OUT-13/14 · OUT-A07 / OUT-A08" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3929" width="213.83999999999997" height="22" />
        </mxCell>
        <mxCell id="cell-66" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#444444;strokeColor=#444444;">
          <mxGeometry as="geometry" x="28" y="4060" width="1744" height="36" />
        </mxCell>
        <mxCell id="cell-67" value="3 · Reconcile only the unknown action; keep independent evidence visible" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#ffffff;spacing=0;">
          <mxGeometry as="geometry" x="40" y="4067" width="763.68" height="28" />
        </mxCell>
        <mxCell id="cell-68" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="540" y="4505" width="720" height="92" />
        </mxCell>
        <mxCell id="cell-69" value="Record the original outcome once and publish the committed change. If no reliable&#10;observation is available, retain unknown and open an owned operations case." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="4513" width="810.66" height="49" />
        </mxCell>
        <mxCell id="cell-70" value="OUT-13 · OUT-INT-10" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="4573" width="144.23999999999998" height="22" />
        </mxCell>
        <mxCell id="cell-71" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="30" y="4832" width="720" height="115" />
        </mxCell>
        <mxCell id="cell-72" value="Show recipient delivery and public-copy progress separately, with evidence and&#10;required actions. API receipt, transport acknowledgement and buyer acceptance&#10;have different meanings." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="44" y="4840" width="781.0799999999999" height="71" />
        </mxCell>
        <mxCell id="cell-73" value="OUT-14/15 · Lifecycle spec owns later business outcomes" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="44" y="4923" width="394.79999999999995" height="22" />
        </mxCell>
