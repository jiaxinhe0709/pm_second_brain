        <mxCell id="cell-28" value="critical · Proposed ERP issue/copy boundary; actual protocol and failure handling require OUT-Q03 qualification" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="36" y="2397" width="977.6999999999999" height="25" />
