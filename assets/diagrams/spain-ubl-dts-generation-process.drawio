<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device"><diagram id="spain-ubl-dts-generation-process" name="Spain UBL: generation, retrieval and recovery"><mxGraphModel dx="1600" dy="1230" page="1" pageWidth="1600" pageHeight="1230" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Spain UBL: generation, retrieval and recovery" style="text;html=1;fontSize=27;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="1550" height="40" as="geometry" /></mxCell><mxCell id="subtitle" value="Proposed flow • one pinned generation operation • DTS does not send an invoice" style="text;html=1;fontSize=17;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="60" width="1550" height="30" as="geometry" /></mxCell><mxCell id="lane0" value="Domain Service - E-Invoice Service" style="shape=swimlane;startSize=60;horizontal=1;fillColor=#dedede;swimlaneFillColor=#f6f6f6;strokeColor=#cccccc;fontSize=17;fontStyle=1;noLabel=1;" vertex="1" parent="1"><mxGeometry x="25" y="115" width="440" height="1035" as="geometry" /></mxCell><mxCell id="lane1" value="Domain Service - Other Services" style="shape=swimlane;startSize=60;horizontal=1;fillColor=#dedede;swimlaneFillColor=#f6f6f6;strokeColor=#cccccc;fontSize=17;fontStyle=1;noLabel=1;" vertex="1" parent="1"><mxGeometry x="580" y="115" width="440" height="1035" as="geometry" /></mxCell><mxCell id="lane2" value="Domain Service - Other Services" style="shape=swimlane;startSize=60;horizontal=1;fillColor=#dedede;swimlaneFillColor=#f6f6f6;strokeColor=#cccccc;fontSize=17;fontStyle=1;noLabel=1;" vertex="1" parent="1"><mxGeometry x="1135" y="115" width="440" height="1035" as="geometry" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4c555c;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g01" target="g02"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4c555c;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g02" target="g03"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" value="async work" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4c555c;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="g03" target="g04"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4c555c;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g04" target="g05"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge4" value="pass" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4c555c;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g05" target="g06"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4c555c;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g06" target="g07"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4c555c;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g07" target="g08"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge7" value="acceptance uncertain" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#956720;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="g03" target="g09a"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge8" value="original operation" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#956720;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="g09a" target="g03"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="245" y="315" /><mxPoint x="800" y="315" /></Array></mxGeometry></mxCell><mxCell id="edge9" value="technical / partial commit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#956720;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="g06" target="g09b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1355" y="910" /><mxPoint x="800" y="910" /></Array></mxGeometry></mxCell><mxCell id="edge10" value="blocked" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#a34141;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="g05" target="gfail"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="594" /><mxPoint x="1560" y="1014" /></Array></mxGeometry></mxCell><mxCell id="edge11" value="correct source after known outcome" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#a34141;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="gfail" target="gcorrect"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1355" y="1110" /><mxPoint x="245" y="1110" /></Array></mxGeometry></mxCell><mxCell id="edge12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#a34141;strokeWidth=2.4;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="gcorrect" target="g01"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="1014" /><mxPoint x="40" y="224" /></Array></mxGeometry></mxCell><mxCell id="g01" value="UM-01&lt;br&gt;&lt;b&gt;Capture source revision&lt;/b&gt;&lt;br&gt;Immutable source and declared contract" style="rounded=1;arcSize=12;fillColor=#e8e8e8;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="350" height="88" as="geometry" /></mxCell><mxCell id="g02" value="UM-02&lt;br&gt;&lt;b&gt;Authorize and admit&lt;/b&gt;&lt;br&gt;Reject unsupported or unauthorized input" style="rounded=1;arcSize=12;fillColor=#e8e8e8;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="625" y="180" width="350" height="88" as="geometry" /></mxCell><mxCell id="g03" value="UM-03&lt;br&gt;&lt;b&gt;Bind and dispatch&lt;/b&gt;&lt;br&gt;Stable identity and pinned capability" style="rounded=1;arcSize=12;fillColor=#e8e8e8;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="625" y="365" width="350" height="88" as="geometry" /></mxCell><mxCell id="g04" value="UM-04&lt;br&gt;&lt;b&gt;Generate UBL XML&lt;/b&gt;&lt;br&gt;Distinct candidate; repeat-safe execution" style="rounded=1;arcSize=12;fillColor=#e8e8e8;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="365" width="350" height="88" as="geometry" /></mxCell><mxCell id="g05" value="UM-05&lt;br&gt;&lt;b&gt;Validate and compare&lt;/b&gt;&lt;br&gt;Exact rules and required invoice meaning" style="rounded=1;arcSize=12;fillColor=#e8e8e8;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="550" width="350" height="88" as="geometry" /></mxCell><mxCell id="g06" value="UM-06&lt;br&gt;&lt;b&gt;Commit one outcome&lt;/b&gt;&lt;br&gt;Success only with readable valid artifact" style="rounded=1;arcSize=12;fillColor=#e8e8e8;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="735" width="350" height="88" as="geometry" /></mxCell><mxCell id="g07" value="UM-07&lt;br&gt;&lt;b&gt;Expose task and result&lt;/b&gt;&lt;br&gt;200 / 303 plus explicit success or error" style="rounded=1;arcSize=12;fillColor=#e8e8e8;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="625" y="735" width="350" height="88" as="geometry" /></mxCell><mxCell id="g08" value="UM-08&lt;br&gt;&lt;b&gt;Capture durable result&lt;/b&gt;&lt;br&gt;Exact XML; consumer owns custody" style="rounded=1;arcSize=50;fillColor=#ffffff;strokeColor=#444;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="735" width="350" height="88" as="geometry" /></mxCell><mxCell id="g09a" value="UM-09&lt;br&gt;&lt;b&gt;Reconcile acceptance&lt;/b&gt;&lt;br&gt;Reuse original key; never blind fallback" style="rounded=1;arcSize=12;fillColor=#fff5df;strokeColor=#956720;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;shape=octagon;" vertex="1" parent="1"><mxGeometry x="70" y="365" width="350" height="88" as="geometry" /></mxCell><mxCell id="g09b" value="UM-09&lt;br&gt;&lt;b&gt;Recover technical fault&lt;/b&gt;&lt;br&gt;Inspect state; resume pinned work safely" style="rounded=1;arcSize=12;fillColor=#fff5df;strokeColor=#956720;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;shape=octagon;" vertex="1" parent="1"><mxGeometry x="625" y="970" width="350" height="88" as="geometry" /></mxCell><mxCell id="gfail" value="UM-05 / 06&lt;br&gt;&lt;b&gt;Block invalid output&lt;/b&gt;&lt;br&gt;Rule failure or semantic loss" style="rounded=1;arcSize=12;fillColor=#fff2f2;strokeColor=#a34141;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="970" width="350" height="88" as="geometry" /></mxCell><mxCell id="gcorrect" value="UM-09 → UM-01&lt;br&gt;&lt;b&gt;Create corrected revision&lt;/b&gt;&lt;br&gt;New linked request; preserve original" style="rounded=1;arcSize=12;fillColor=#fff2f2;strokeColor=#a34141;strokeWidth=2;fontSize=17;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="970" width="350" height="88" as="geometry" /></mxCell><mxCell id="footer0" value="Acceptance uncertainty reconciles the same operation. Technical replay retains the pinned mapper and rules." style="text;html=1;align=left;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="1160" width="1550" height="25" as="geometry" /></mxCell><mxCell id="footer1" value="Invalid output has no successful download. Correction creates a new revision; downstream dispatch is separate." style="text;html=1;align=left;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="1186" width="1550" height="25" as="geometry" /></mxCell><mxCell id="lane0-label" value="&lt;b&gt;Domain Service -&lt;br&gt;E-Invoice Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Generation consumer / records&lt;/span&gt;" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=4;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="115" width="440" height="60" /></mxCell><mxCell id="lane1-label" value="&lt;b&gt;Domain Service -&lt;br&gt;Other Services&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;DTS API / orchestration&lt;/span&gt;" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=4;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="115" width="440" height="60" /></mxCell><mxCell id="lane2-label" value="&lt;b&gt;Domain Service -&lt;br&gt;Other Services&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;DTS mapper / validation&lt;/span&gt;" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=4;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1135" y="115" width="440" height="60" /></mxCell></root></mxGraphModel></diagram></mxfile>