                <object label="5. Deliver once to the ERP" link="../../specs/invoice-receiving/SPEC-SEI-026-invoice-retrieval-logical-feature-specification.md#32-receiving-handoff" id="deliver-title">
                    <mxCell parent="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=23;fontColor=#222222;" vertex="1">
                        <mxGeometry height="36" width="516" x="192" y="1332" as="geometry"/>
                    </mxCell>
                </object>
                <object label="Preserve the invoice identity.&#xa;Confirm ERP receipt before claiming success." link="../../specs/invoice-receiving/SPEC-SEI-026-invoice-retrieval-logical-feature-specification.md#32-receiving-handoff" id="deliver-body">
                    <mxCell parent="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=18;fontColor=#222222;" vertex="1">
                        <mxGeometry height="52" width="516" x="192" y="1374" as="geometry"/>
                    </mxCell>
                </object>
                <object label="6. Show result and next action" link="../../specs/invoice-receiving/SPEC-SEI-026-invoice-retrieval-logical-feature-specification.md#32-receiving-handoff" id="result-title">
                    <mxCell parent="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=23;fontColor=#222222;" vertex="1">
