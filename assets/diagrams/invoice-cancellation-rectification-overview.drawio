        <mxCell id="title" value="Spain: cancel or correct an issued invoice&#10;Two independent flows. Full customer rejection does not automatically cancel the invoice." style="text;whiteSpace=wrap;html=0;align=left;fontSize=20;" vertex="1" parent="1">
