<mxfile host="app.diagrams.net" type="device"><diagram id="public-platform-connector-process" name="Process"><mxGraphModel dx="3200" dy="961" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="961" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Public platform connector: send requests, save results and recover" style="text;html=1;align=left;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="15" width="3150" height="42" /></mxCell><mxCell id="subtitle" value="Logical responsibility groups; exact service owners and implementation remain open in the owning spec." style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="58" width="3150" height="30" /></mxCell><mxCell id="phase-0" value="RECEIVE THE REQUEST" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="285" y="98" width="680" height="28" /></mxCell><mxCell id="phase-1" value="CHECK PERMISSION &amp; SUPPORT" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="975" y="98" width="680" height="28" /></mxCell><mxCell id="phase-2" value="SAVE &amp; SEND THE REQUEST" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1665" y="98" width="740" height="28" /></mxCell><mxCell id="phase-3" value="SAVE RESULTS &amp; RECOVER" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="2415" y="98" width="760" height="28" /></mxCell><mxCell id="lane-2" value="Domain Service - E-Invoice Service" style="shape=swimlane;horizontal=0;startSize=250;noLabel=1;fillColor=#e5e5e5;swimlaneFillColor=#fafafa;strokeColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="170" width="3150" height="309" /></mxCell><mxCell id="lane-2-label" value="&lt;b&gt;Domain Service -&lt;br&gt;E-Invoice Service&lt;/b&gt;" style="text;html=1;fontSize=15;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=16;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="170" width="250" height="309" /></mxCell><mxCell id="lane-3" value="Domain Service - Other Services" style="shape=swimlane;horizontal=0;startSize=250;noLabel=1;fillColor=#e5e5e5;swimlaneFillColor=#fafafa;strokeColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="493" width="3150" height="164" /></mxCell><mxCell id="lane-3-label" value="&lt;b&gt;Domain Service -&lt;br&gt;Other Services&lt;/b&gt;" style="text;html=1;fontSize=15;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=16;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="493" width="250" height="164" /></mxCell><mxCell id="lane-4" value="Operations / support" style="shape=swimlane;horizontal=0;startSize=250;noLabel=1;fillColor=#e5e5e5;swimlaneFillColor=#fafafa;strokeColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="671" width="3150" height="172" /></mxCell><mxCell id="lane-4-label" value="&lt;b&gt;Operations / support&lt;/b&gt;" style="text;html=1;fontSize=15;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=16;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="671" width="250" height="172" /></mxCell><mxCell id="edge-0" value="" source="p1" target="p2" parent="1" edge="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#55555