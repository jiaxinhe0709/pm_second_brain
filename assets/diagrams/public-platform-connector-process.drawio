r=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1820" y="920" width="280" height="108" /></mxCell><mxCell id="footer" value="Feature owners interpret business results. Readiness does not activate routes. Unknown effects remain held until proven safe to resume." style="text;html=1;fontSize=12;align=left;strokeColor=none;fillColor=none;fontColor=#444444;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1060" width="3150" height="30" /></mxCell></root></mxGraphModel></diagram></mxfile>