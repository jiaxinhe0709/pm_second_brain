;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" workflowLabel="execute"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2090" y="252" /><mxPoint x="2090" y="575" /></Array></mxGeometry></mxCell><mxCell id="label-edge-6" value="execute" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2097" y="402.5" width="46.5" height="22" /></mxCell><mxCell id="edge-7" value="" source="p6" target="p7" parent="1" edge="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" workflowLabel="linked response"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2400" y="575" /><mxPoint x="2400" y="252" /></Array></mxGeometry></mxCell><mxCell id="label-edge-7" value="linked response" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2280.5" y="402.5" width="112.5" height="22" /></mxCell><mxCell id="edge-8" value="" source="p6" target="p9" parent="1" edge="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" workflowLabel="unknown"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2400" y="575" /><mxPoint x="2400" y="389.5" /></Array></mxGeometry></mxCell><mxCell id="label-edge-8" value="unknown" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2407" y="471.25" width="46.5" height="22" /></mxCell><mxCell id="edge-9" value="" source="p7" target="p9" parent="1" edge="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=7 5;" workflowLabel="record missing"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2570" y="322" /><mxPoint x="2575" y="322" /></Array></mxGeometry></mxCell><mxCell id="label-edge-9" value="record missing" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2577" y="306" width="74" height="22" /></mxCell><mxCell id="edge-10" value="" source="p7" target="p8" parent="1" edge="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=7 5;" workflowLabel="saved result"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="label-edge-10" value="saved result" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2727.5" y="225" width="85" height="22" /></mxCell><mxCell id="edge-11" value="" source="p9" target="p6" parent="1" edge="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=7 5;" workflowLabel="check original request"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2430" y="389.5" /><mxPoint x="2430" y="575" /></Array></mxGeometry></mxCell><mxCell id="label-edge-11" value="check original request" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2437" y="517.625" width="107" height="22" /></mxCell><mxCell id="p1" value="&lt;b&gt;Receive the service request&lt;/b&gt;&lt;br&gt;Keep the request ID and input fingerprint&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;PCN-01&lt;/span&gt;" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="310" y="202" width="260" height="100" /></mxCell><mxCell id="p2" value="&lt;b&gt;Check customer and environment&lt;/b&gt;&lt;br&gt;Business, country, test or production&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;PCN-02&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="202" width="260" height="100" /></mxCell><mxCell id="p4" value="&lt;b&gt;Check platform support&lt;/b&gt;&lt;br&gt;Approved contract and readiness&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;PCN-04&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="1240" y="202" width="260" height="100" /></mxCell><mxCell id="gate" value="Can this request be sent?" style="rhombus;fillColor=#d7d7d7;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="1540" y="332" width="240" height="110" /></mxCell><mxCell id="p5" value="&lt;b&gt;Save the request before sending&lt;/b&gt;&lt;br&gt;Keep the original ID; one worker sends&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;PCN-05&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="1820" y="202" width="260" height="100" /></mxCell><mxCell id="p7" value="&lt;b&gt;Save the response and evidence&lt;/b&gt;&lt;br&gt;Keep each item result and response record&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;PCN-07&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2440" y="202" width="260" height="100" /></mxCell><mxCell id="p8" value="&lt;b&gt;Return the result to the service&lt;/b&gt;&lt;br&gt;Say if the outcome is known, pending or unknown&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;PCN-08&lt;/span&gt;" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2840" y="202" width="260" height="100" /></mxCell><mxCell id="hold" value="&lt;b&gt;Hold the request&lt;/b&gt;&lt;br&gt;Permission denied or action unsupported&lt;br&gt;No call is sent" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="1530" y="202" width="260" height="100" /></mxCell><mxCell id="p9" value="&lt;b&gt;Check what happened before retrying&lt;/b&gt;&lt;br&gt;Use the original request and context&lt;br&gt;Keep an owner for unresolved cases&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;PCN-09&lt;/span&gt;" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2440" y="332" width="270" height="115" /></mxCell><mxCell id="p3" value="&lt;b&gt;Check permission and credentials&lt;/b&gt;&lt;br&gt;Permission and credentials for this action&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;PCN-03&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="525" width="260" height="100" /></mxCell><mxCell id="p6" value="&lt;b&gt;Call the public platform&lt;/b&gt;&lt;br&gt;Use the fixed destination and approved limits&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;PCN-06&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="2130" y="525" width="260" height="100" /></mxCell><mxCell id="p10" value="&lt;b&gt;Update settings for future requests&lt;/b&gt;&lt;br&gt;Record the change and affected scope&lt;br&gt;Keep pending work and history&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;PCN-10&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="1820" y="703" width="280" height="108" /></mxCell><mxCell id="footer" value="The calling service interprets business results. A ready connection does not activate a route. Check uncertain outcomes before retrying." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="886" width="3150" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>