olor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=2 5;exitX=0.5;exitY=0.0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="P3" target="S3"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="E13" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#777777;strokeWidth=2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=2 5;exitX=0.5;exitY=0.0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="P4" target="S4"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="E14" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#777777;strokeWidth=2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=2 5;exitX=0.5;exitY=0.0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="X1" target="P1"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="E15" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#777777;strokeWidth=2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=2 5;exitX=0.5;exitY=0.0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="X2" target="P4"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="B1" value="&lt;b&gt;Request setup for the business&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Business administrator&lt;/span&gt;" style="shape=ellipse;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="290" y="202" width="220" height="100" as="geometry" /></mxCell><mxCell id="B2" value="&lt;b&gt;Request setup for one client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Accountant acting for one client&lt;/span&gt;" style="shape=ellipse;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="290" y="332" width="220" height="100" as="geometry" /></mxCell><mxCell id="C1" value="&lt;b&gt;Correct the business identity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Provide a new evidence revision&lt;/span&gt;" style="shape=parallelogram;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="900" y="202" width="240" height="100" as="geometry" /></mxCell><mxCell id="C2" value="&lt;b&gt;Obtain the customer&amp;#x27;s permission&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Permission for this client and action&lt;/span&gt;" style="shape=hexagon;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1200" y="202" width="240" height="100" as="geometry" /></mxCell><mxCell id="B3" value="&lt;b&gt;Show the setup result&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Ready, limited or action needed&lt;/span&gt;" style="shape=parallelogram;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2200" y="510" width="240" height="100" as="geometry" /></mxCell><mxCell id="J1" value="&lt;b&gt;Open a setup case&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;One business and environment&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="600" y="688" width="220" height="110" as="geometry" /></mxCell><mxCell id="S3" value="&lt;b&gt;Check readiness for each function&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Issue, receive, report and download&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1500" y="688" width="240" height="110" as="geometry" /></mxCell><mxCell id="S5" value="&lt;b&gt;Activate the approved route&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Direction, environment and effective time&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2200" y="688" width="240" height="110" as="geometry" /></mxCell><mxCell id="S1" value="&lt;b&gt;Verify the business identity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Identifier, business type and presence&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="900" y="876" width="240" height="110" as="geometry" /></mxCell><mxCell id="S2" value="&lt;b&gt;Is the actor allowed to act?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Client, function and permitted period&lt;/span&gt;" style="shape=rhombus;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d1d1d1;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1200" y="876" width="240" height="110" as="geometry" /></mxCell><mxCell id="S4" value="&lt;b&gt;Configure the invoice route&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Connection, credentials and trust&lt;/span&gt;" style="shape=document;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1800" y="876" width="240" height="110" as="geometry" /></mxCell><mxCell id="P1" value="&lt;b&gt;Provide the business identity rules&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Country-specific identity classes&lt;/span&gt;" style="shape=document;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#555;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="900" y="1016" width="240" height="100" as="geometry" /></mxCell><mxCell id="P2" value="&lt;b&gt;Provide delegated permission evidence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Authentication is a separate check&lt;/span&gt;" style="shape=document;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#555;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1200" y="1016" width="240" height="100" as="geometry" /></mxCell><mxCell id="P3" value="&lt;b&gt;Check certificates for this purpose&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Signer, protected access and expiry&lt;/span&gt;" style="shape=document;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#555;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1500" y="876" width="240" height="100" as="geometry" /></mxCell><mxCell id="P4" value="&lt;b&gt;Check the saved route status&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Configured does not mean active&lt;/span&gt;" style="shape=cylinder;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;spacingTop=24;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1800" y="1016" width="240" height="100" as="geometry" /></mxCell><mxCell id="X1" value="&lt;b&gt;Check official business identity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Only where access is approved&lt;/span&gt;" style="shape=trapezoid;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#555;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="900" y="1194" width="240" height="100" as="geometry" /></mxCell><mxCell id="X2" value="&lt;b&gt;Check required external registration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Establish the actual external state&lt;/span&gt;" style="shape=trapezoid;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#555;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1800" y="1194" width="240" height="100" as="geometry" /></mxCell><mxCell id="footer" value="Direct and accountant intake converge on one legal-entity, capability-specific assessment" style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1369" width="2550" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>