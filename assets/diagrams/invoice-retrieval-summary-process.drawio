        <mxCell id="exception-meaning" parent="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=16;fontColor=#222222;" value="All E markers use the same exception result." vertex="1">
          <mxGeometry height="28" width="1220" x="40" y="2182.0" as="geometry" />
        </mxCell>
        <mxCell id="scope-note" parent="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=17;fontColor=#222222;" value="Stage 1 is inbound only. The list also includes sent invoices. Customer access does not wait for ERP delivery." vertex="1">
          <mxGeometry height="30" width="2310" x="40" y="2220.0" as="geometry" />
        </mxCell>
        <object label="Solid: process steps and handoffs. Dashed: saved-file availability, conditional choices or exception references. Stage numbers are not delivery phases. Detailed rules: SPEC026." link="../../specs/invoice-receiving/SPEC-SEI-026-invoice-retrieval-logical-feature-specification.md#retrieval-detailed-process" id="line-legend">
          <mxCell parent="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=15;fontColor=#222222;" vertex="1">
            <mxGeometry height="28" width="2310" x="40" y="2256.0" as="geometry" />
          </mxCell>
        </object>
        <object label="File returned:&#10;repeat intake checks;&#10;verify original and matching." link="../../specs/invoice-receiving/SPEC-SEI-026-invoice-retrieval-logical-feature-specification.md#original-file-retrieval" id="original-return-label">
          <mxCell parent="1" style="text;fillColor=none;strokeColor=none;align=left;spacing=2;html=0;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#111111;" vertex="1">
            <mxGeometry height="60" width="215" x="545" y="875" as="geometry" />
          </mxCell>
        </object>
        <object id="copy-purpose-title" label="Why retrieve a faithful copy?" link="../../specs/invoice-receiving/SPEC-SEI-025-invoice-retrieval-solution-summary.md#why-retrieve-faithful-copy">
          <mxCell parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=22;fontColor=#222222;">
            <mxGeometry as="geometry" x="872" y="272" width="636" height="38" />
          </mxCell>
        </object>
        <object id="copy-purpose-body" label="Show available invoice information while&#10;the original is delayed or inaccessible.&#10;Keep public-copy evidence for later matching.&#10;Allow safe, authorised view and download.&#10;Keep the copy label and original recovery open." link="../../specs/invoice-receiving/SPEC-SEI-025-invoice-retrieval-solution-summary.md#why-retrieve-faithful-copy">
          <mxCell parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=18;fontColor=#222222;">
            <mxGeometry as="geometry" x="872" y="315" width="636" height="160" />
          </mxCell>
        </object>
        <object id="public-original-context-title" label="SPFE can supply the original" link="../../specs/invoice-receiving/SPEC-SEI-025-invoice-retrieval-solution-summary.md#retrieval-use-cases">
          <mxCell parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=22;fontColor=#222222;">
            <mxGeometry as="geometry" x="1642" y="272" width="686" height="38" />
          </mxCell>
        </object>
        <object id="public-original-context-body" label="SPFE may handle issuance or exchange&#10;between private platforms.&#10;No additional faithful copy is required.&#10;Check the file role and the actual route.&#10;Provider support still needs confirmation." link="../../specs/invoice-receiving/SPEC-SEI-025-invoice-retrieval-solution-summary.md#retrieval-use-cases">
          <mxCell parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=18;fontColor=#222222;">
            <mxGeometry as="geometry" x="1642" y="315" width="686" height="160" />
          </mxCell>
        </object>
        <object id="original-unavailable-title" label="Check account and connection" link="../../specs/invoice-receiving/SPEC-SEI-025-invoice-retrieval-solution-summary.md#retrieval-readiness-and-sender-contact">
          <mxCell parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=22;fontColor=#222222;">
            <mxGeometry as="geometry" x="832" y="1152" width="436" height="38" />
          </mxCell>
        </object>
        <object id="original-unavailable-body" label="Show the reason and next owner.&#10;Customer completes missing setup&#10;or restores receiving access.&#10;Otherwise ask the receiving provider.&#10;ERP delivery stays pending." link="../../specs/invoice-receiving/SPEC-SEI-025-invoice-retrieval-solution-summary.md#retrieval-readiness-and-sender-contact">
          <mxCell parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=17;fontColor=#222222;">
            <mxGeometry as="geometry" x="832" y="1195" width="436" height="130" />
          </mxCell>
        </object>
        <object id="original-escalation-title" label="If delivery remains unclear" link="../../specs/invoice-receiving/SPEC-SEI-025-invoice-retrieval-solution-summary.md#retrieval-readiness-and-sender-contact">
          <mxCell parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=22;fontColor=#222222;">
            <mxGeometry as="geometry" x="1502" y="1152" width="706" height="38" />
          </mxCell>
        </object>
        <object id="original-escalation-body" label="The receiving provider checks invoice delivery.&#10;If unresolved, the customer asks the sender to confirm&#10;the destination or make the existing original available.&#10;Use the agreed channel; a returned file repeats checks.&#10;Missing access alone does not require cancellation." link="../../specs/invoice-receiving/SPEC-SEI-025-invoice-retrieval-solution-summary.md#retrieval-readiness-and-sender-contact">
          <mxCell parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=17;fontColor=#222222;">
            <mxGeometry as="geometry" x="1502" y="1195" width="706" height="130" />
          </mxCell>
        </object>
        <mxCell id="original-unavailable-label" value="Still missing / blocked" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=16;fontColor=#222222;">
          <mxGeometry as="geometry" x="1080" y="1070" width="210" height="40" />
        </mxCell>
        <mxCell id="original-delivery-unresolved-label" value="Delivery still&#10;unclear" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=16;fontColor=#222222;">
          <mxGeometry as="geometry" x="1310" y="1170" width="150" height="50" />
        </mxCell>
        <mxCell id="original-access-restored-label" value="After setup/access&#10;is restored" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;spacing=2;fontFamily=Arial;fontSize=16;fontColor=#222222;">
          <mxGeometry as="geometry" x="570" y="1090" width="180" height="48" />
        </mxCell>
      </root>
