        <mxCell id="v33" value="" parent="1" vertex="1" style="rounded=0;arcSize=8;fillColor=#fafafa;strokeColor=#626262;">
          <mxGeometry as="geometry" x="38" y="767" width="954" height="88" />
        </mxCell>
        <mxCell id="v34" value="Assess the account on the chosen platform for the selected business/client. An existing provider account may&#10;need a Sage connection; a valid Sage connection is reused. An accountant account must cover that client under&#10;the qualified provider/authority model." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=16;fontColor=#626262;">
          <mxGeometry as="geometry" x="52" y="775" width="1110.72" height="72" />
        </mxCell>
        <mxCell id="v35" value="" parent="1" vertex="1" style="rounded=0;arcSize=8;fillColor=#fafafa;strokeColor=#626262;">
          <mxGeometry as="geometry" x="38" y="939" width="954" height="88" />
        </mxCell>
        <mxCell id="v36" value="ERP/product presents required provider onboarding or a customer/provider handoff, then resumes the same&#10;request with completion evidence. GAP-02/06/08 must qualify the method and owner. Unknown account status or&#10;unsupported onboarding remains pending; do not assume account absence or a create-account API. ONB-05." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=16;fontColor=#626262;">
          <mxGeometry as="geometry" x="52" y="947" width="1090.56" height="72" />
        </mxCell>
        <mxCell id="v37" value="" parent="1" vertex="1" style="rounded=0;arcSize=8;fillColor=#fafafa;strokeColor=#626262;">
          <mxGeometry as="geometry" x="38" y="1954" width="954" height="88" />
        </mxCell>
        <mxCell id="v38" value="Assess access evidence for each requested function before confirming readiness. Reuse matching current&#10;evidence; obtain only missing or stale evidence through qualified checks. A connection or provider-account&#10;result alone is insufficient. ONB-06; GAP-05/06." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=16;fontColor=#626262;">
          <mxGeometry as="geometry" x="52" y="1962" width="1080.48" height="72" />
