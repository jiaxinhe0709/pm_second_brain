          <mxGeometry as="geometry" x="38" y="2274" width="954" height="66" />
        </mxCell>
        <mxCell id="v40" value="End: reuse matching setup; otherwise follow each address status. IN_PROGRESS/RETRYING means wait and observe.&#10;Route activation is separate." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=16;fontColor=#626262;">
