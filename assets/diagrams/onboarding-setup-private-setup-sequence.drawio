        <mxCell id="v32" value="Start: the selected business/client uses a chosen supported private platform. Keep a valid account or complete&#10;its qualified onboarding; then connect to Sage. Inputs: resolved dataset, chosen service and account evidence." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=16;fontColor=#626262;">
          <mxGeometry as="geometry" x="52" y="266" width="1120.8" height="49" />
