        <mxCell id="cell-37" value="1 · Common · Capture requested functions; acknowledge saved request" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#ffffff;spacing=0;">
          <mxGeometry as="geometry" x="40" y="309" width="711.4799999999999" height="28" />
