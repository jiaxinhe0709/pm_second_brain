          <mxGeometry as="geometry" x="540" y="567" width="465" height="115" />
        </mxCell>
        <mxCell id="cell-39" value="Save the work item, request key and input digest. A&#10;repeated key with the same input returns the&#10;existing item; changed input conflicts." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="575" width="514.8599999999999" height="71" />
        </mxCell>
        <mxCell id="cell-40" value="ONB-01 · ONB-D01" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="658" width="123.35999999999999" height="22" />
        </mxCell>
        <mxCell id="cell-41" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#444444;strokeColor=#444444;">
          <mxGeometry as="geometry" x="28" y="969" width="1744" height="36" />
        </mxCell>
        <mxCell id="cell-42" value="2 · Common · Check business identity and authority; assess current setup" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#ffffff;spacing=0;">
          <mxGeometry as="geometry" x="40" y="976" width="763.68" height="28" />
        </mxCell>
        <mxCell id="cell-43" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#ededed;strokeColor=#888888;dashed=1;">
          <mxGeometry as="geometry" x="540" y="1234" width="720" height="92" />
        </mxCell>
        <mxCell id="cell-44" value="If authority is missing, expired or unknown, stop affected checks. Save the&#10;reason and required action. Return the scoped result through ONB-11." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="1242" width="751.5" height="49" />
        </mxCell>
        <mxCell id="cell-45" value="ONB-02 · Main path below assumes authority passed" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="1302" width="353.03999999999996" height="22" />
        </mxCell>
        <mxCell id="cell-46" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="540" y="1561" width="975" height="92" />
        </mxCell>
        <mxCell id="cell-47" value="Record the per-function plan. Reuse only valid matching evidence. A failed or incomplete lookup remains&#10;unknown; it does not prove no existing setup. Valid unchanged functions need no new external work." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="1569" width="1027.58" height="49" />
        </mxCell>
        <mxCell id="cell-48" value="ONB-10 · ONB-D10" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="1629" width="123.35999999999999" height="22" />
        </mxCell>
        <mxCell id="cell-49" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#444444;strokeColor=#444444;">
          <mxGeometry as="geometry" x="28" y="1760" width="1744" height="36" />
        </mxCell>
        <mxCell id="cell-50" value="3 · Common · Check access and trust requirements" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#ffffff;spacing=0;">
          <mxGeometry as="geometry" x="40" y="1767" width="513.1199999999999" height="28" />
        </mxCell>
        <mxCell id="cell-51" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="540" y="2025" width="975" height="92" />
        </mxCell>
        <mxCell id="cell-52" value="NOT_REQUIRED needs approved policy evidence. UNDETERMINED blocks dependent work. Keep business NIF, caller&#10;authentication and action authority separate. Evaluate each access or signing purpose separately." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="2033" width="1057.1599999999999" height="49" />
        </mxCell>
        <mxCell id="cell-53" value="ONB-03 · ONB-D02/03" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="2093" width="144.23999999999998" height="22" />
        </mxCell>
        <mxCell id="cell-54" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="795" y="2332" width="720" height="138" />
        </mxCell>
        <mxCell id="cell-55" value="The qualified Tax/certificate capability resolves authorised existing references&#10;and validates suitability. Confirm the subject or authorised representative,&#10;purpose, role, environment, source/material version, validity and effective&#10;grant. It owns certificate controls; E-Invoice Service receives no key bytes." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="809" y="2340" width="800.8" height="93" />
        </mxCell>
        <mxCell id="cell-56" value="SPEC-001 CERT-03/04/05 · Source and execution owner require ONB-Q06" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="809" y="2446" width="478.32" height="22" />
        </mxCell>
        <mxCell id="cell-57" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="540" y="2685" width="975" height="92" />
        </mxCell>
        <mxCell id="cell-58" value="Valid existing certificate: reuse its protected reference and current scoped decision. No repeat upload. This&#10;decision does not perform authentication or sign an invoice." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="2693" width="1086.74" height="49" />
        </mxCell>
        <mxCell id="cell-59" value="ONB-03 · ONB-D04" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="2753" width="123.35999999999999" height="22" />
        </mxCell>
        <mxCell id="edge-60" edge="1" parent="1" style="edgeStyle=none;rounded=0;strokeColor=#555555;endArrow=none;dashed=1;">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="25" y="2842" />
            <mxPoint as="targetPoint" x="1775" y="2842" />
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cell-61" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=white;strokeColor=none;">
          <mxGeometry as="geometry" x="31" y="2847" width="1738" height="29" />
        </mxCell>
        <mxCell id="cell-62" value="Confirmed missing, expired, revoked or unsuitable required certificate" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="39" y="2852" width="621.0" height="25" />
        </mxCell>
        <mxCell id="cell-63" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#ededed;strokeColor=#888888;dashed=1;">
          <mxGeometry as="geometry" x="540" y="2912" width="975" height="92" />
        </mxCell>
        <mxCell id="cell-64" value="Hold dependent work. Return the confirmed reason and correction owner through ONB-11. The approved SPEC-001&#10;process supplies replacement or corrected evidence. Recheck the affected parent gate." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="2920" width="1067.02" height="49" />
        </mxCell>
        <mxCell id="cell-65" value="ONB-08 · SPEC-004 OFR-03/08 · No automatic signer change" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="2980" width="401.76" height="22" />
        </mxCell>
        <mxCell id="edge-66" edge="1" parent="1" style="edgeStyle=none;rounded=0;strokeColor=#555555;endArrow=none;dashed=1;">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="25" y="3069" />
            <mxPoint as="targetPoint" x="1775" y="3069" />
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cell-67" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=white;strokeColor=none;">
          <mxGeometry as="geometry" x="31" y="3074" width="1738" height="29" />
        </mxCell>
        <mxCell id="cell-68" value="Unavailable, stale, ambiguous or unqualified source contract" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="39" y="3079" width="534.0" height="25" />
        </mxCell>
        <mxCell id="cell-69" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#ededed;strokeColor=#888888;dashed=1;">
          <mxGeometry as="geometry" x="540" y="3139" width="975" height="92" />
        </mxCell>
        <mxCell id="cell-70" value="Keep readiness unconfirmed. Do not infer missing material or request another upload. SPEC-004 permits only&#10;qualified safe-read retry or owned escalation. Resume this check after reliable evidence returns." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3147" width="1057.1599999999999" height="49" />
        </mxCell>
        <mxCell id="cell-71" value="ONB-08 · SPEC-004 OFR-02/04/07/08 · No mutation inferred" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3207" width="401.76" height="22" />
        </mxCell>
        <mxCell id="cell-72" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="540" y="3318" width="975" height="115" />
        </mxCell>
        <mxCell id="cell-73" value="The main path continues only when the verified business NIF, required certificate readiness and effective&#10;action authority pass. Failed or unknown checks return owned actions; independently valid functions remain&#10;intact." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3326" width="1057.1599999999999" height="71" />
        </mxCell>
        <mxCell id="cell-74" value="ONB-03 · Credential checks precede dependent platform operations" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3409" width="457.43999999999994" height="22" />
