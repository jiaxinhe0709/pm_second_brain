;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="b3" target="b8" workflowLabel="unresolved"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="435" /><mxPoint x="1260" y="796" /></Array></mxGeometry></mxCell><mxCell id="label-e7" value="unresolved" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1267" y="604.5" width="63" height="22" /></mxCell><mxCell id="b6" value="END&lt;br&gt;&lt;b&gt;Explain result&lt;/b&gt;&lt;br&gt;One client and aggregate" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2060" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="b1" value="OFR-05&lt;br&gt;&lt;b&gt;Freeze operation&lt;/b&gt;&lt;br&gt;Original hash and operation ID" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="310" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b3" value="DECISION&lt;br&gt;&lt;b&gt;Outcome proven?&lt;/b&gt;&lt;br&gt;Success, absence or unresolved" style="rhombus;fillColor=#d7d7d7;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1010" y="380" width="240" height="110" as="geometry" /></mxCell><mxCell id="b4" value="OFR-06&lt;br&gt;&lt;b&gt;Commit success once&lt;/b&gt;&lt;br&gt;Original effect and evidence" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b5" value="OFR-08&lt;br&gt;&lt;b&gt;Update item state&lt;/b&gt;&lt;br&gt;Readiness only if gates pass" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1710" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="b2" value="OFR-06&lt;br&gt;&lt;b&gt;Query authority&lt;/b&gt;&lt;br&gt;Same entity and environment" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="660" y="568" width="230" height="100" as="geometry" /></mxCell><mxCell id="b7" value="OFR-04&lt;br&gt;&lt;b&gt;Retry if permitted&lt;/b&gt;&lt;br&gt;Proven absence and same identity" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="568" width="230" height="100" as="geometry" /></mxCell><mxCell id="b8" value="OFR-07&lt;br&gt;&lt;b&gt;Escalate unresolved&lt;/b&gt;&lt;br&gt;Owner, evidence and deadline" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="746" width="230" height="100" as="geometry" /></mxCell><mxCell id="footer" value="Observe authoritative state before declaring success, absence or permission to repeat. An empty or failed query does not prove absence. A manual decision cites source evidence and cannot erase actual external state." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="921" width="2750" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>