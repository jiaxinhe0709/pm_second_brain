<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device"><diagram id="onboarding-public-readiness-process" name="Public onboarding: capability readiness"><mxGraphModel dx="2800" dy="1126" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1126" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Check public-platform setup requirements" style="text;html=1;align=left;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="15" width="2750" height="42" /></mxCell><mxCell id="subtitle" value="Logical responsibility groups; exact service owners and implementation remain open in the owning spec." style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="58" width="2750" height="30" /></mxCell><mxCell id="phase0" value="CONFIRM THE REQUEST" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="285" y="98" width="585" height="28" as="geometry" /></mxCell><mxCell id="phase1" value="CHECK &amp; PREPARE" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="880" y="98" width="585" height="28" as="geometry" /></mxCell><mxCell id="phase2" value="APPLY &amp; CONFIRM THE CHANGE" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="1475" y="98" width="605" height="28" as="geometry" /></mxCell><mxCell id="phase3" value="KEEP HISTORY &amp; CLOSE SAFELY" style="rounded=1;fillColor=#d7d7d7;strokeColor=none;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeo