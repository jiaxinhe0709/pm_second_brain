=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="a4" target="a5" workflowLabel="sufficient"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1610" y="613" /><mxPoint x="1610" y="608" /></Array></mxGeometry></mxCell><mxCell id="label-e4" value="sufficient" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1628.5" y="581" width="63" height="22" /></mxCell><mxCell id="e5" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1950" y="608" /><mxPoint x="1950" y="430" /></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=7 5;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="a2" target="a8" workflowLabel="missing grant"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="926" /><mxPoint x="900" y="252" /></Array></mxGeometry></mxCell><mxCell id="label-e6" value="missing grant" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="907" y="578" width="79.5" height="22" /></mxCell><mxCell id="e7" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=7 5;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="a4" target="a7" workflowLabel="unknown"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1610" y="613" /><mxPoint x="1610" y="748" /></Array></mxGeometry></mxCell><mxCell id="label-e7" value="unknown" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1617" y="669.5" width="46.5" height="22" /></mxCell><mxCell id="a8" value="&lt;b&gt;Correct the affected client item&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Obtain permission or missing evidence&lt;/span&gt;" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1010" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="a6" value="&lt;b&gt;Show the result and next steps&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;This does not activate an invoice route&lt;/span&gt;" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2060" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="a1" value="&lt;b&gt;Start setup for one business&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Selected function and environment&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;ONB-01&lt;/span&gt;" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="310" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="a4" value="&lt;b&gt;Are the required checks complete?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Ready, limited or still unknown&lt;/span&gt;" style="rhombus;fillColor=#d7d7d7;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="558" width="240" height="110" as="geometry" /></mxCell><mxCell id="a5" value="&lt;b&gt;Record the setup result&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep each function and check separate&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;ONB-04&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1710" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="a7" value="&lt;b&gt;Check the original setup operation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Use the original external request&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;ONB-08&lt;/span&gt;" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1710" y="698" width="230" height="100" as="geometry" /></mxCell><mxCell id="a2" value="&lt;b&gt;Check business identity and permission&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Verify the represented business and action&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;ONB-02&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="660" y="876" width="230" height="100" as="geometry" /></mxCell><mxCell id="a3" value="&lt;b&gt;Check the setup requirements&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;External evidence and certificate rules&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;ONB-03&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1010" y="876" width="230" height="100" as="geometry" /></mxCell><mxCell id="footer" value="Per legal subject and capability; direct and accountant work items use the same isolated gates. A portfolio returns independent child outcomes. READY is capability readiness, not invoice compliance, external registration or private route activation." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1051" width="2750" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>