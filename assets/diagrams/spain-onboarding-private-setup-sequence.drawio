          <mxGeometry as="geometry" x="540" y="4084" width="975" height="115" />
        </mxCell>
        <mxCell id="cell-87" value="The main path continues only when the verified business NIF, required certificate readiness and effective&#10;action authority pass. Failed or unknown checks return owned actions; independently valid functions remain&#10;intact." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="4092" width="1057.1599999999999" height="71" />
        </mxCell>
        <mxCell id="cell-88" value="ONB-06 · Credential checks precede dependent platform operations" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
