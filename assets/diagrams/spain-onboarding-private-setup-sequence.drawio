        <mxCell id="cell-79" value="Unavailable, stale, ambiguous or unqualified source contract" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#222222;spacing=0;">
