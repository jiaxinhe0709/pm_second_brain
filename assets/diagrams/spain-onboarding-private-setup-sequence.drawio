          <mxGeometry as="geometry" x="540" y="1234" width="720" height="92" />
        </mxCell>
        <mxCell id="cell-50" value="If authority is missing, expired or unknown, stop affected checks. Save the&#10;reason and required action. Return the scoped result through ONB-11." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="1242" width="751.5" height="49" />
        </mxCell>
        <mxCell id="cell-51" value="ONB-02 · Main path below assumes authority passed" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="1302" width="353.03999999999996" height="22" />
        </mxCell>
        <mxCell id="cell-52" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="540" y="1561" width="975" height="92" />
        </mxCell>
        <mxCell id="cell-53" value="Record the per-function plan. Reuse only valid matching evidence. A failed or incomplete lookup remains&#10;unknown; it does not prove no existing setup. Valid unchanged functions need no new external work." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="1569" width="1027.58" height="49" />
        </mxCell>
        <mxCell id="cell-54" value="ONB-10 · ONB-D10" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="1629" width="123.35999999999999" height="22" />
        </mxCell>
        <mxCell id="cell-55" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#444444;strokeColor=#444444;">
          <mxGeometry as="geometry" x="28" y="1760" width="1744" height="36" />
        </mxCell>
        <mxCell id="cell-56" value="2a · Scenario-specific · Configure missing provider settings" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#ffffff;spacing=0;">
          <mxGeometry as="geometry" x="40" y="1767" width="638.4" height="28" />
        </mxCell>
        <mxCell id="cell-57" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="540" y="2095" width="975" height="115" />
        </mxCell>
        <mxCell id="cell-58" value="Bind the existing provider account with permission. Keep the provider unless a supported change was requested.&#10;New enrolment, subscription or publication needs a contract requirement and separate authority; configure only&#10;missing settings." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="2103" width="1096.6" height="71" />
        </mxCell>
        <mxCell id="cell-59" value="ONB-05 · External changes require saved intent and recovery controls" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="2186" width="485.28" height="22" />
        </mxCell>
        <mxCell id="cell-60" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#444444;strokeColor=#444444;">
          <mxGeometry as="geometry" x="28" y="2333" width="1744" height="36" />
        </mxCell>
        <mxCell id="cell-61" value="3 · Common · Check access and trust requirements" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#ffffff;spacing=0;">
          <mxGeometry as="geometry" x="40" y="2340" width="513.1199999999999" height="28" />
        </mxCell>
        <mxCell id="cell-62" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="540" y="2598" width="975" height="92" />
        </mxCell>
        <mxCell id="cell-63" value="NOT_REQUIRED needs approved policy evidence. UNDETERMINED blocks dependent work. Keep business NIF, caller&#10;authentication and action authority separate. Evaluate each access or signing purpose separately." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="2606" width="1057.1599999999999" height="49" />
        </mxCell>
        <mxCell id="cell-64" value="ONB-06 · ONB-D02/03" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="2666" width="144.23999999999998" height="22" />
        </mxCell>
        <mxCell id="cell-65" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="795" y="2905" width="720" height="138" />
        </mxCell>
        <mxCell id="cell-66" value="The qualified Tax/certificate capability resolves authorised existing references&#10;and validates suitability. Confirm the subject or authorised representative,&#10;purpose, role, environment, source/material version, validity and effective&#10;grant. It owns certificate controls; E-Invoice Service receives no key bytes." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="809" y="2913" width="800.8" height="93" />
        </mxCell>
        <mxCell id="cell-67" value="SPEC-001 CERT-03/04/05 · Source and execution owner require ONB-Q06" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="809" y="3019" width="478.32" height="22" />
        </mxCell>
        <mxCell id="cell-68" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f7f7f7;strokeColor=#888888;">
          <mxGeometry as="geometry" x="540" y="3258" width="975" height="92" />
        </mxCell>
        <mxCell id="cell-69" value="Valid existing certificate: reuse its protected reference and current scoped decision. No repeat upload. This&#10;decision does not perform authentication or sign an invoice." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3266" width="1086.74" height="49" />
        </mxCell>
