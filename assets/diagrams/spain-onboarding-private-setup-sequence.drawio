        <mxCell id="cell-73" value="Confirmed missing, expired, revoked or unsuitable required certificate" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="39" y="3425" width="621.0" height="25" />
