        </mxCell>
        <mxCell id="cell-45" value="Save the work item, request key and input digest. A&#10;repeated key with the same input returns the&#10;existing item; changed input conflicts." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="575" width="514.8599999999999" height="71" />
        </mxCell>
        <mxCell id="cell-46" value="ONB-01 · ONB-D01" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="658" width="123.35999999999999" height="22" />
        </mxCell>
        <mxCell id="cell-47" value="" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#444444;strokeColor=#444444;">
          <mxGeometry as="geometry" x="28" y="969" width="1744" height="36" />
        </mxCell>
        <mxCell id="cell-48" value="2 · Common · Check business identity and authority; assess current setup" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#ffffff;spacing=0;">
          <mxGeometry as="geometry" x="40" y="976" width="763.68" height="28" />
