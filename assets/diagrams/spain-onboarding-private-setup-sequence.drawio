          <mxGeometry as="geometry" x="540" y="4821" width="975" height="115" />
        </mxCell>
        <mxCell id="cell-92" value="Inspect current entry-point evidence first. Publish or change only when the plan and contract require it, after&#10;saving original intent and operation identity. A possible effect uses ONB-08 / OFR-01–08; do not repeat it&#10;blindly." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="4829" width="1106.46" height="71" />
