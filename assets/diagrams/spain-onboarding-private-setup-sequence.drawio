          <mxGeometry as="geometry" x="540" y="3875" width="975" height="138" />
        </mxCell>
        <mxCell id="cell-84" value="If a protected prerequisite operation may have executed, hold its original identity and observe the same&#10;business, environment and correlation through its qualified owner. Confirmed success is recorded once and&#10;resumes this check. Proven absence permits retry only under the qualified contract. Conflict or unresolved&#10;evidence keeps dependent work on hold with an owner; an empty or failed query is not proof of absence." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3883" width="1057.1599999999999" height="93" />
        </mxCell>
        <mxCell id="cell-85" value="ONB-06/08 · OFR-05/06/07/08 · Preserve valid unaffected functions" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3989" width="464.4" height="22" />
