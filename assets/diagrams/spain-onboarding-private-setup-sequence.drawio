        </mxCell>
        <mxCell id="cell-81" value="Keep readiness unconfirmed. Do not infer missing material or request another upload. The OFR controls permit&#10;only qualified safe-read retry or owned escalation. Resume this check after reliable evidence returns." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3720" width="1076.8799999999999" height="49" />
        </mxCell>
        <mxCell id="cell-82" value="ONB-08 · SPEC-002 OFR-02/04/07/08 · No mutation inferred" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3780" width="401.76" height="22" />
