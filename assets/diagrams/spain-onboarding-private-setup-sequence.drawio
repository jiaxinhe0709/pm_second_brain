          <mxGeometry as="geometry" x="540" y="3485" width="975" height="92" />
        </mxCell>
        <mxCell id="cell-75" value="Hold dependent work. Return the confirmed reason and correction owner through ONB-11. The approved SPEC-001&#10;process supplies replacement or corrected evidence. Recheck the affected parent gate." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#222222;spacing=0;">
          <mxGeometry as="geometry" x="554" y="3493" width="1067.02" height="49" />
        </mxCell>
        <mxCell id="cell-76" value="ONB-08 · SPEC-002 OFR-03/08 · No automatic signer change" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;spacing=0;">
