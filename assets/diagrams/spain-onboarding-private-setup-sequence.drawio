        <mxCell id="cell-90" value="4 · Scenario-specific · Check private functions; activate only when required" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#ffffff;spacing=0;">
          <mxGeometry as="geometry" x="40" y="4313" width="805.4399999999999" height="28" />
