l id="e16" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=7 5;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="auth" target="denied" workflowLabel="denied"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="430" /><mxPoint x="870" y="570" /></Array></mxGeometry></mxCell><mxCell id="label-e16" value="denied" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="877" y="489" width="41" height="22" /></mxCell><mxCell id="e17" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2.2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=7 5;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="accept" target="denied" workflowLabel="invalid / conflict"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1065" y="510" /><mxPoint x="1080" y="510" /></Array></mxGeometry></mxCell><mxCell id="label-e17" value="invalid / conflict" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1072" y="484" width="107" height="22" /></mxCell><mxCell id="request" value="GPA-03&lt;br&gt;&lt;b&gt;Request invoice intent&lt;/b&gt;&lt;br&gt;Customer send or inbound ingest" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="310" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="read" value="GPA-07 / 08&lt;br&gt;&lt;b&gt;Retrieve / acknowledge&lt;/b&gt;&lt;br&gt;Scoped reads and event recovery" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2545" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="auth" value="GPA-03&lt;br&gt;&lt;b&gt;Check current authority&lt;/b&gt;&lt;br&gt;Principal, entity, action and scope" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="630" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="accept" value="GPA-04&lt;br&gt;&lt;b&gt;Save durable receipt&lt;/b&gt;&lt;br&gt;Per-item digest and repeat identity" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="950" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="intent" value="DECISION&lt;br&gt;&lt;b&gt;Which accepted intent?&lt;/b&gt;&lt;br&gt;Send or ingest" style="rhombus;fillColor=#d7d7d7;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1270" y="380" width="240" height="110" as="geometry" /></mxCell><mxCell id="inbound" value="GPA-05&lt;br&gt;&lt;b&gt;Ingest received original&lt;/b&gt;&lt;br&gt;Dedup, quarantine, product scope" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1270" y="520" width="240" height="100" as="geometry" /></mxCell><mxCell id="plan" value="GPA-05&lt;br&gt;&lt;b&gt;Freeze final send plan&lt;/b&gt;&lt;br&gt;Route, profile, trust, separate actions" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1610" y="380" width="250" height="100" as="geometry" /></mxCell><mxCell id="known" value="DECISION&lt;br&gt;&lt;b&gt;Result established?&lt;/b&gt;&lt;br&gt;Known or unknown" style="rhombus;fillColor=#d7d7d7;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2230" y="380" width="240" height="110" as="geometry" /></mxCell><mxCell id="evidence" value="GPA-06&lt;br&gt;&lt;b&gt;Save source evidence&lt;/b&gt;&lt;br&gt;Event, invoice, action, reference, time" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2550" y="380" width="220" height="100" as="geometry" /></mxCell><mxCell id="derive" value="GPA-06 / 08&lt;br&gt;&lt;b&gt;History + durable events&lt;/b&gt;&lt;br&gt;Independent state and action outcomes" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2210" y="520" width="260" height="100" as="geometry" /></mxCell><mxCell id="denied" value="GPA-03 / 04&lt;br&gt;&lt;b&gt;Deny / correct input&lt;/b&gt;&lt;br&gt;No protected effect or disclosure" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="950" y="520" width="260" height="100" as="geometry" /></mxCell><mxCell id="reconcile" value="GPA-08 / 12&lt;br&gt;&lt;b&gt;Reconcile original action&lt;/b&gt;&lt;br&gt;Claim expiry cannot permit resend" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1940" y="380" width="250" height="100" as="geometry" /></mxCell><mxCell id="execute" value="GPA-05&lt;br&gt;&lt;b&gt;One assigned executor&lt;/b&gt;&lt;br&gt;Sage adapter OR partner claim" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1940" y="698" width="250" height="100" as="geometry" /></mxCell><mxCell id="footer" value="Proposed design. Customer send, inbound ingest and provider execution use separate permissions within one API contract. Solid arrows: owned request or result. Dashed: evidence, event or recovery. API receipt, notification acknowledgement and buyer acceptance remain separate." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="873" width="2750" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>