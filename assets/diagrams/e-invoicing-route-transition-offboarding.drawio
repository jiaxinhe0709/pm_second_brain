r=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="N3" target="C2" workflowLabel="Ready"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1660" y="613" /><mxPoint x="1660" y="608" /></Array></mxGeometry></mxCell><mxCell id="label-E9" value="Ready" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1737.25" y="581" width="35.5" height="22" /></mxCell><mxCell id="E10" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="H3" target="C2" workflowLabel="Covered"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1660" y="883" /><mxPoint x="1660" y="608" /></Array></mxGeometry></mxCell><mxCell id="label-E10" value="Covered" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1667" y="734.5" width="46.5" height="22" /></mxCell><mxCell id="E11" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="C2" target="C3" workflowLabel="Both pass"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="label-E11" value="Both pass" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2096.25" y="174" width="57.5" height="22" /></mxCell><mxCell id="E12" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="C2" target="B4" workflowLabel="Blocked"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="label-E12" value="Blocked" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1982" y="667" width="46.5" height="22" /></mxCell><mxCell id="E13" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="C3" target="C4"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="E14" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="C4" target="B3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2510" y="490" /><mxPoint x="2525" y="490" /></Array></mxGeometry></mxCell><mxCell id="B1" value="&lt;b&gt;Request an invoice-route change&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Business, direction and affected work&lt;/span&gt;" style="shape=ellipse;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="300" y="202" width="250" height="100" as="geometry" /></mxCell><mxCell id="B3" value="&lt;b&gt;Show the exit result and evidence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Switch time, export and retained access&lt;/span&gt;" style="shape=parallelogram;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2400" y="380" width="250" height="100" as="geometry" /></mxCell><mxCell id="C1" value="&lt;b&gt;Open the route-change case&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;One active request for the affected work&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="300" y="558" width="250" height="100" as="geometry" /></mxCell><mxCell id="N3" value="&lt;b&gt;Is the new route ready?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Permission and receiving access&lt;/span&gt;" style="shape=rhombus;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d1d1d1;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1400" y="558" width="250" height="110" as="geometry" /></mxCell><mxCell id="N4" value="&lt;b&gt;Keep the old route while held&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Resolve the new destination&amp;#x27;s readiness&lt;/span&gt;" style="shape=hexagon;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1400" y="698" width="250" height="100" as="geometry" /></mxCell><mxCell id="H1" value="&lt;b&gt;List unfinished earlier work&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Pending invoices and status updates&lt;/span&gt;" style="shape=cylinder;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;spacingTop=24;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="650" y="558" width="250" height="100" as="geometry" /></mxCell><mxCell id="H2" value="&lt;b&gt;Assign earlier invoice duties&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Historical responses and reporting&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1000" y="558" width="250" height="100" as="geometry" /></mxCell><mxCell id="H3" value="&lt;b&gt;Can earlier work continue safely?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Required access and evidence retained&lt;/span&gt;" style="shape=rhombus;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d1d1d1;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1400" y="828" width="250" height="110" as="geometry" /></mxCell><mxCell id="H4" value="&lt;b&gt;Keep required historical access&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Resolve outstanding earlier duties&lt;/span&gt;" style="shape=hexagon;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1400" y="968" width="250" height="100" as="geometry" /></mxCell><mxCell id="C2" value="&lt;b&gt;Can the route change proceed?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Both readiness and continuity must pass&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1850" y="558" width="250" height="100" as="geometry" /></mxCell><mxCell id="B4" value="&lt;b&gt;Hold the route change&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Correct or check the failed condition&lt;/span&gt;" style="shape=hexagon;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1850" y="698" width="250" height="100" as="geometry" /></mxCell><mxCell id="C3" value="&lt;b&gt;Activate the route for future work&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Only eligible new work changes&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2150" y="558" width="220" height="100" as="geometry" /></mxCell><mxCell id="C4" value="&lt;b&gt;Retain or release earlier access&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Release only after required checks pass&lt;/span&gt;" style="shape=document;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2400" y="558" width="220" height="100" as="geometry" /></mxCell><mxCell id="N1" value="&lt;b&gt;Configure the new destination&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Check connection and certificate readiness&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="650" y="1146" width="250" height="100" as="geometry" /></mxCell><mxCell id="N2" value="&lt;b&gt;Verify the receiving destination&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Observe actual external registration&lt;/span&gt;" style="shape=cylinder;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;spacingTop=24;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1000" y="1146" width="250" height="100" as="geometry" /></mxCell><mxCell id="footer" value="Prove the new route and account for old invoices before changing or releasing anything" style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1321" width="2650" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>