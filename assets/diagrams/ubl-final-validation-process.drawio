rent="1"><mxGeometry x="1710" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="d6" value="END&lt;br&gt;&lt;b&gt;Return evidence&lt;/b&gt;&lt;br&gt;Exchange owns actual send" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2060" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="d7" value="UV-05&lt;br&gt;&lt;b&gt;Return blocking issue&lt;/b&gt;&lt;br&gt;Customer or Sage action" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="342" width="240" height="100" as="geometry" /></mxCell><mxCell id="d3" value="UV-04&lt;br&gt;&lt;b&gt;Revalidate bytes&lt;/b&gt;&lt;br&gt;Final target representation" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1010" y="520" width="230" height="100" as="geometry" /></mxCell><mxCell id="footer" value="The final signed or sent representation must match current route, profile, rules and trust plan. Preview is never a send authorisation. A blocking or undetermined final check stops the external mutation." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="695" width="2750" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>