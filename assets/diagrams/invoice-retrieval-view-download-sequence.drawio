          <mxGeometry as="geometry" x="38" y="258" width="1339" height="112" />
        </mxCell>
        <mxCell id="v33" value="Customer consultation covers sent and received invoices. ERP calls the E-Invoice Service through the shared&#10;Query/Retrieve API. Reuse the NIF/business dataset binding and existing certificate/authority setup; the GETs&#10;use a Sage ID M2M token. Recheck current user/client permission. Automatic receiving is inbound only." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=16;fontColor=#626262;">
          <mxGeometry as="geometry" x="52" y="266" width="1110.72" height="72" />
        </mxCell>
        <mxCell id="v34" value="SPEC026 §2; RSD-07; RET-G01/03/05" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=12;fontColor=#626262;">
          <mxGeometry as="geometry" x="52" y="346" width="261.48" height="26" />
        </mxCell>
        <mxCell id="v35" value="" parent="1" vertex="1" style="rounded=0;arcSize=8;fillColor=#fafafa;strokeColor=#626262;">
          <mxGeometry as="geometry" x="38" y="1429" width="1339" height="134" />
        </mxCell>
        <mxCell id="v36" value="Keep the selected ID and business context; qualify the list-to-detail ID under RET-G01. Metadata alone is not&#10;a complete view. Retrieve includeAttachments defaults to true. With false, descriptors and URL/Factur-X&#10;generation are omitted, but availableAttachments is retained. A positive count does not itself return file&#10;choices or links." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=16;fontColor=#626262;">
          <mxGeometry as="geometry" x="52" y="1437" width="1110.72" height="95" />
        </mxCell>
        <mxCell id="v37" value="INT-RCV03, snapshot 13 November; RET-API-01/02" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=12;fontColor=#626262;">
          <mxGeometry as="geometry" x="52" y="1539" width="359.76" height="26" />
        </mxCell>
        <mxCell id="v38" value="" parent="1" vertex="1" style="rounded=0;arcSize=8;fillColor=#fafafa;strokeColor=#626262;">
          <mxGeometry as="geometry" x="38" y="2345" width="1339" height="134" />
        </mxCell>
        <mxCell id="v39" value="Apply file access, role, safety and integrity checks. A zero attachment count is distinct from omitted&#10;descriptors. Qualify readable content and SPFE inbound freshness. Safe saved access can continue during source&#10;outage or pending inbound ERP delivery, including an authorised faithful copy. Viewing/download does not&#10;create buyer acceptance." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=16;fontColor=#626262;">
          <mxGeometry as="geometry" x="52" y="2353" width="1120.8" height="95" />
        </mxCell>
