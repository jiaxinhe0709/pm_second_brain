        <mxCell id="v29" value="ERP/product first checks permission to view the selected business or accountant client. Firm login does not&#10;replace client access. The product uses its qualified SXS integration; actual interface and business/client&#10;mapping remain GAP-01/06." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;spacing=0;verticalAlign=top;align=left;fontSize=16;fontColor=#626262;">
