<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device"><diagram id="e-invoicing-inbound-exchange" name="Inbound invoice exchange"><mxGraphModel dx="2500" dy="1396" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1396" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Receive invoices and handle invalid or repeated items" style="text;html=1;align=left;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="15" width="2450" height="42" /></mxCell><mxCell id="subtitle" value="Logical responsibility groups; exact service owners and implementation remain open in the owning spec." style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="58" width="2450" height="30" /></mxCell><mxCell id="lane-1" value="ERP / product" style="shape=swimlane;horizontal=0;startSize=250;noLabel=1;fillColor=#e5e5e5;swimlaneFillColor=#fafafa;strokeColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="170" width="2450" height="164" /></mxCell><mxCell id="lane-1-label" value="&lt;b&gt;ERP / product&lt;/b&gt;" style="text;html=1;fontSize=15;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=16;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="170" width="250" height="164" /></mxCell><mxCell id="lane-2" value="Domain Service - E-Invoice Service" style="shape=swimlane;horizontal=0;startSize=250;noLabel=1;fillColor=#e5e5e5;swimlaneFillColor=#fafafa;strokeColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="348" width="2450" height="304" /></mxCell><mxCell id="lane-2-label" value="&lt;b&gt;Domain Service -&lt;br&gt;E-Invoice Service&lt;/b&gt;" style="text;html=1;fontSize=15;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=16;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mx