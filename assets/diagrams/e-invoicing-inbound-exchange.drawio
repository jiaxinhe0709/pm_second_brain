444;strokeWidth=2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="S3" target="Q2" workflowLabel="Yes"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="label-E8" value="Yes" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1732" y="494" width="30" height="22" /></mxCell><mxCell id="E9" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="S4" target="Q3"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="E10" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="S5" target="B3"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="B3" value="&lt;b&gt;Make the invoice available&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Original, status and history&lt;/span&gt;" style="shape=parallelogram;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2200" y="202" width="250" height="100" as="geometry" /></mxCell><mxCell id="J1" value="&lt;b&gt;Record one received invoice item&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep its source route&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="700" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="S1" value="&lt;b&gt;Check the source and recipient&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Channel, environment and recipient&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1000" y="380" width="250" height="110" as="geometry" /></mxCell><mxCell id="S3" value="&lt;b&gt;Is this a duplicate invoice?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Business and network identity&lt;/span&gt;" style="shape=rhombus;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d1d1d1;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1600" y="380" width="250" height="110" as="geometry" /></mxCell><mxCell id="S5" value="&lt;b&gt;Deliver to the authorised product&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Approved business and product&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2200" y="380" width="250" height="110" as="geometry" /></mxCell><mxCell id="Q2" value="&lt;b&gt;Link the duplicate observation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Do not create a second business invoice&lt;/span&gt;" style="shape=hexagon;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1600" y="520" width="250" height="100" as="geometry" /></mxCell><mxCell id="S2" value="&lt;b&gt;Is the file safe and trusted?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Integrity, repeated input and file safety&lt;/span&gt;" style="shape=rhombus;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d1d1d1;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1300" y="698" width="250" height="110" as="geometry" /></mxCell><mxCell id="S4" value="&lt;b&gt;Validate and keep the original&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Original file, profile and rules&lt;/span&gt;" style="shape=document;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#333;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1900" y="698" width="250" height="110" as="geometry" /></mxCell><mxCell id="Q1" value="&lt;b&gt;Hold the unsafe item for review&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Unsafe source or file&lt;/span&gt;" style="shape=hexagon;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1300" y="838" width="250" height="100" as="geometry" /></mxCell><mxCell id="Q3" value="&lt;b&gt;Hold the invalid file&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Assign the correction owner&lt;/span&gt;" style="shape=hexagon;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#222;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1900" y="838" width="250" height="100" as="geometry" /></mxCell><mxCell id="X1" value="&lt;b&gt;Retrieve from the public platform&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Authorised query and download&lt;/span&gt;" style="shape=trapezoid;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#555;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="300" y="1016" width="260" height="100" as="geometry" /></mxCell><mxCell id="X2" value="&lt;b&gt;Receive from a private platform&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Approved push or polling interface&lt;/span&gt;" style="shape=trapezoid;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#555;strokeWidth=2;fontColor=#222222;fontSize=14;align=center;verticalAlign=middle;spacing=7;dashed=1;dashPattern=6 4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="300" y="1146" width="260" height="100" as="geometry" /></mxCell><mxCell id="footer" value="Public retrieval or private arrival converges on trust, identity and duplicate controls" style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1321" width="2450" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>