e="a4" target="a8" workflowLabel="unknown"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1910" y="608" /><mxPoint x="1910" y="786" /></Array></mxGeometry></mxCell><mxCell id="label-e7" value="unknown" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1917" y="686" width="46.5" height="22" /></mxCell><mxCell id="input-platform" source="platform-input" target="a1" edge="1" parent="1" value="" workflowLabel="" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#444444;strokeWidth=2;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="964" /><mxPoint x="550" y="430" /></Array></mxGeometry></mxCell><mxCell id="input-product" source="product-input" target="a1" edge="1" parent="1" value="" workflowLabel="" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#444444;strokeWidth=2;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="252" /><mxPoint x="550" y="430" /></Array></mxGeometry></mxCell><mxCell id="product-input" value="&lt;b&gt;Record a business event&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Authorised decision or payment&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;"><mxGeometry as="geometry" x="310" y="202" width="230" height="100" /></mxCell><mxCell id="a7" value="&lt;b&gt;Show the invoice history&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Original events remain available&lt;/span&gt;" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2780" y="202" width="230" height="100" as="geometry" /></mxCell><mxCell id="a1" value="&lt;b&gt;Receive status or a business event&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep the source identity&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LCS-01&lt;/span&gt;" style="ellipse;fillColor=#ffffff;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="650" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="a2" value="&lt;b&gt;Check the event&amp;#x27;s identity and context&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Actor, invoice and original route&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LCS-02&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="990" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="a3" value="&lt;b&gt;Save the original event evidence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Source codes, time, hash and links&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LCS-03&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1330" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="a5" value="&lt;b&gt;Update the invoice status view&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Keep exchange, business and payment separate&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LCS-05&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2010" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="a6" value="&lt;b&gt;Share status and history&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Source, freshness and next action&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LCS-06&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2350" y="380" width="230" height="100" as="geometry" /></mxCell><mxCell id="a4" value="&lt;b&gt;Interpret the source information&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Use country and provider rules&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LCS-04&lt;/span&gt;" style="rounded=1;fillColor=#e8e8e8;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1670" y="558" width="230" height="100" as="geometry" /></mxCell><mxCell id="a8" value="&lt;b&gt;Investigate unclear information&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Unknown code or conflicting event&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LCS-10&lt;/span&gt;" style="shape=hexagon;dashed=1;dashPattern=7 5;fillColor=#f6f6f6;whiteSpace=wrap;html=1;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2010" y="736" width="230" height="100" as="geometry" /></mxCell><mxCell id="platform-input" value="&lt;b&gt;Provide platform status information&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Query result or supported notification&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontColor=#111111;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;"><mxGeometry as="geometry" x="310" y="914" width="230" height="100" /></mxCell><mxCell id="footer" value="Public/private platform status information and authorised customer/ERP events are separate inputs. Public status queries are established in Article 10; automatic notifications require a confirmed contract. Technical acknowledgement does not prove buyer acceptance or payment." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1089" width="3090" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>